---
// /blog/tags/<tag>/ and its /page/<n>/ pages.
import type { InferGetStaticPropsType } from "astro";
import BlogListing from "../../../../components/marketing/blog/BlogListing.astro";
import { getListings, pageParam } from "../../../../utils/blog";

export async function getStaticPaths() {
  return (await getListings("tag")).map((props) => ({
    params: { tag: props.listing.facet.slug, page: pageParam(props.listing.page) },
    props,
  }));
}
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
---

<BlogListing {...Astro.props} />
