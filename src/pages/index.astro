---
import MarketingLayout from "../layouts/MarketingLayout.astro";
---

<MarketingLayout
  title="Music Assistant — Your music. Your way."
  description="Bring your streaming services and your own files into one library, and play them on almost any speaker in your home."
>
  <section id="top" class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1>
          Your music.
          <br />
          Your way.
        </h1>
        <p class="hero-lead">
          Bring your streaming services and your own files into one library, and
          play them on almost any speaker in your home.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="/get-started/">
            Get Music Assistant
          </a>
        </div>
        <p class="hero-note">
          Free and open source · A project of the Open Home Foundation
        </p>
      </div>

      <div class="hero-product" aria-label="Music Assistant interface preview">
        <figure class="product-frame">
          <img
            src="/assets/landing/discover.png"
            fetchpriority="high"
            alt="Music Assistant Discover screen showing players, recommendations and music controls"
          />
        </figure>
        <p class="hand-note" aria-hidden="true">
          Same music.
          <br />
          More ways
          <br />
          to listen.
        </p>
      </div>
    </div>
  </section>

