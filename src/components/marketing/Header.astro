---
import githubRepo from "../../data/github-repo.json";
import Button from "./ui/Button.astro";
import Icon from "./ui/Icon.astro";
import Logo from "./ui/Logo.astro";

const { stars, url: repoUrl = "https://github.com/music-assistant/server" } =
  githubRepo as { stars?: number; url?: string };
// 1234 -> "1.2k", the way GitHub shows it.
const starCount =
  stars === undefined
    ? undefined
    : new Intl.NumberFormat("en", {
        notation: "compact",
        maximumFractionDigits: 1,
      })
        .format(stars)
        .toLowerCase();
const path = Astro.url.pathname;

const links = [
  { href: "/blog/", label: "News", current: path.startsWith("/blog") },
  { href: "/documentation/", label: "Documentation" },
];
---

<header class="site-header">
  <div class="container inner">
    <div class="brand">
      <a href="/" class="home" aria-label="Music Assistant home">
        <Logo />
      </a>
    </div>

    <nav id="site-nav" class="nav" aria-label="Main">
      <ul>
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={link.current ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <div class="nav-actions">
        <button
          class="icon-button theme-toggle"
          type="button"
          data-theme-toggle
          aria-label="Switch between light and dark theme"
        >
          <span class="to-light">
            <Icon name="sun" />
          </span>
          <span class="to-dark">
            <Icon name="moon" />
          </span>
        </button>
        <a
          class="github"
          href={repoUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={starCount
            ? `Music Assistant on GitHub, ${stars} stars`
            : "Music Assistant on GitHub"}
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 16 16"
            aria-hidden="true"
            focusable="false"
          >
            <path
              fill="currentColor"
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
            />
          </svg>
          {starCount && (
            <span class="stars" aria-hidden="true">
              <Icon name="star" size={14} />
              {starCount}
            </span>
          )}
        </a>
        <Button href="/get-started/" class="nav-install">
          Get Music Assistant
        </Button>
      </div>
    </nav>

    <button
      class="menu-toggle icon-button"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
    >
      <span class="open">
        <Icon name="menu" />
      </span>
      <span class="close">
        <Icon name="x" />
      </span>
      <span class="sr-only" data-menu-label>
        Open menu
      </span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 50;
    top: 0;
    color: var(--fg);
    background: color-mix(in srgb, var(--page) 85%, transparent);
    border-bottom: 1px solid transparent;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    transition: border-color 0.2s;
  }
  :global(.is-scrolled) .site-header {
    border-bottom-color: var(--line);
  }
  .inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: var(--header-height);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-inline-end: auto;
  }
  .home {
    display: block;
    height: 1.625rem;
    color: var(--fg);
  }
  .nav,
  .nav ul,
  .nav-actions {
    display: flex;
    align-items: center;
  }
  .nav {
    gap: 1.25rem;
  }
  .nav ul {
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav ul a {
    display: block;
    padding: 0.5rem 0.75rem;
    color: var(--muted);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.15s;
  }
  .nav ul a:hover,
  .nav ul a[aria-current="page"] {
    color: var(--fg);
  }
  .nav-actions {
    gap: 0.25rem;
  }
  .nav-actions :global(.btn) {
    margin-left: 0.5rem;
  }
  .github {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.5rem;
    padding: 0 0.625rem;
    border-radius: var(--radius);
    color: var(--muted);
    font-size: 0.875rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    text-decoration: none;
    transition: color 0.15s;
  }
  .github:hover {
    color: var(--fg);
  }
  .stars {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .icon-button {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    color: var(--muted);
    background: transparent;
    cursor: pointer;
    transition: color 0.15s;
  }
  .icon-button:hover {
    color: var(--fg);
  }
  /* Show the icon for the theme you would switch to. */
  .theme-toggle .to-dark,
  :global(:root[data-theme="light"]) .theme-toggle .to-light {
    display: none;
  }
  :global(:root[data-theme="light"]) .theme-toggle .to-dark {
    display: block;
  }
  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme])) .theme-toggle .to-light {
      display: none;
    }
    :global(:root:not([data-theme])) .theme-toggle .to-dark {
      display: block;
    }
  }
  .menu-toggle {
    display: none;
  }
  .menu-toggle .close,
  .menu-toggle[aria-expanded="true"] .open {
    display: none;
  }
  .menu-toggle[aria-expanded="true"] .close {
    display: block;
  }

  @media (max-width: 960px) {
    .menu-toggle {
      display: grid;
      color: var(--fg);
    }
    .nav {
      position: fixed;
      inset: var(--header-height) 0 auto;
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
      padding: 0.5rem var(--gutter) 1.5rem;
      background: var(--page);
      border-bottom: 1px solid var(--line);
    }
    .nav.is-open {
      display: flex;
    }
    .nav ul {
      flex-direction: column;
      align-items: stretch;
    }
    .nav ul a {
      padding: 0.625rem 0;
      color: var(--fg);
      font-size: 1.25rem;
      font-weight: 500;
    }
    .nav-actions :global(.btn) {
      flex: 1;
    }
  }
</style>
