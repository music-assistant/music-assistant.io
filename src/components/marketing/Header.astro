---
import latestRelease from "../../data/latest-release.json";
import { getPosts } from "../../utils/blog";
import Button from "./ui/Button.astro";
import Icon from "./ui/Icon.astro";
import Logo from "./ui/Logo.astro";

const { version, url: githubUrl } = latestRelease as {
  version?: string;
  url?: string;
};
// Link the version to our own announcement post, like the docs header does.
const latestPost = (await getPosts()).find((post) =>
  post.data.tags?.includes("release"),
);
const releaseUrl = latestPost ? `/${latestPost.id}/` : githubUrl;
const path = Astro.url.pathname;

const links = [
  { href: "/#features", label: "Features" },
  { href: "/blog/", label: "News", current: path.startsWith("/blog") },
  { href: "/documentation/", label: "Documentation" },
];
const isInstall = path.startsWith("/get-started");
---

<header class="site-header">
  <div class="container inner">
    <div class="brand">
      <a href="/" class="home" aria-label="Music Assistant home">
        <Logo />
      </a>
      {version && releaseUrl && (
        <a
          class="version"
          href={releaseUrl}
          title={`Music Assistant ${version} release notes`}
          translate="no"
        >
          {version.startsWith("v") ? version : `v${version}`}
        </a>
      )}
    </div>

    <nav id="site-nav" class="nav" aria-label="Main">
      <ul>
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={link.current ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <div class="nav-actions">
        <button
          class="icon-button theme-toggle"
          type="button"
          data-theme-toggle
          aria-label="Switch between light and dark theme"
        >
          <span class="to-light">
            <Icon name="sun" />
          </span>
          <span class="to-dark">
            <Icon name="moon" />
          </span>
        </button>
        <Button href={isInstall ? "/documentation/" : "/get-started/"}>
          {isInstall ? "Documentation" : "Get Music Assistant"}
        </Button>
      </div>
    </nav>

    <button
      class="menu-toggle icon-button"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
    >
      <span class="open">
        <Icon name="menu" />
      </span>
      <span class="close">
        <Icon name="x" />
      </span>
      <span class="sr-only" data-menu-label>
        Open menu
      </span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 50;
    top: 0;
    color: var(--fg);
    background: color-mix(in srgb, var(--page) 85%, transparent);
    border-bottom: 1px solid transparent;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    transition: border-color 0.2s;
  }
  :global(.is-scrolled) .site-header {
    border-bottom-color: var(--line);
  }
  .inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: var(--header-height);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-inline-end: auto;
  }
  .home {
    display: block;
    height: 1.625rem;
    color: var(--fg);
  }
  .version {
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-decoration: none;
    transition:
      color 0.15s,
      border-color 0.15s;
  }
  .version:hover {
    color: var(--link);
    border-color: var(--accent);
  }
  .nav,
  .nav ul,
  .nav-actions {
    display: flex;
    align-items: center;
  }
  .nav {
    gap: 1.25rem;
  }
  .nav ul {
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav ul a {
    display: block;
    padding: 0.5rem 0.75rem;
    color: var(--muted);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.15s;
  }
  .nav ul a:hover,
  .nav ul a[aria-current="page"] {
    color: var(--fg);
  }
  .nav-actions {
    gap: 0.25rem;
  }
  .nav-actions :global(.btn) {
    margin-left: 0.5rem;
  }
  .icon-button {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    color: var(--muted);
    background: transparent;
    cursor: pointer;
    transition: color 0.15s;
  }
  .icon-button:hover {
    color: var(--fg);
  }
  /* Show the icon for the theme you would switch to. */
  .theme-toggle .to-dark,
  :global(:root[data-theme="light"]) .theme-toggle .to-light {
    display: none;
  }
  :global(:root[data-theme="light"]) .theme-toggle .to-dark {
    display: block;
  }
  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme])) .theme-toggle .to-light {
      display: none;
    }
    :global(:root:not([data-theme])) .theme-toggle .to-dark {
      display: block;
    }
  }
  .menu-toggle {
    display: none;
  }
  .menu-toggle .close,
  .menu-toggle[aria-expanded="true"] .open {
    display: none;
  }
  .menu-toggle[aria-expanded="true"] .close {
    display: block;
  }

  @media (max-width: 960px) {
    .menu-toggle {
      display: grid;
      color: var(--fg);
    }
    .nav {
      position: fixed;
      inset: var(--header-height) 0 auto;
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
      padding: 0.5rem var(--gutter) 1.5rem;
      background: var(--page);
      border-bottom: 1px solid var(--line);
    }
    .nav.is-open {
      display: flex;
    }
    .nav ul {
      flex-direction: column;
      align-items: stretch;
    }
    .nav ul a {
      padding: 0.625rem 0;
      color: var(--fg);
      font-size: 1.25rem;
      font-weight: 500;
    }
    .nav-actions :global(.btn) {
      flex: 1;
    }
  }
</style>
