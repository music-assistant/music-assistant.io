---
import Icon from "./Icon.astro";

// Buttons take their colours from the tone they sit in: "solid" is the tone's
// text colour as a block, "pop" uses the tone's accent ink, "outline" is a
// bordered version.
interface Props {
  href: string;
  variant?: "solid" | "pop" | "outline";
  size?: "md" | "lg";
  icon?: string;
  trailingIcon?: string;
  external?: boolean;
  class?: string;
}

const {
  href,
  variant = "solid",
  size = "md",
  icon,
  trailingIcon,
  external = false,
  class: className,
} = Astro.props;
---

<a
  href={href}
  class:list={["btn", `btn-${variant}`, `btn-${size}`, className]}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
>
  {icon && <Icon name={icon} size={size === "lg" ? 20 : 18} />}
  <span>
    <slot />
  </span>
  {trailingIcon && <Icon name={trailingIcon} size={size === "lg" ? 20 : 18} />}
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    height: 2.75rem;
    padding: 0 1.25rem;
    border: 2px solid var(--fg);
    border-radius: var(--radius);
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition:
      transform 0.15s,
      box-shadow 0.15s,
      background-color 0.15s,
      color 0.15s;
  }
  .btn-lg {
    height: 3.25rem;
    padding: 0 1.5rem;
    font-size: 1.0625rem;
  }
  .btn:hover {
    transform: translate(-2px, -2px);
    box-shadow: 3px 3px 0 var(--fg);
  }
  .btn:active {
    transform: none;
    box-shadow: none;
  }
  .btn-solid {
    color: var(--bg);
    background: var(--fg);
  }
  .btn-solid:hover {
    box-shadow: 3px 3px 0 var(--pop);
  }
  .btn-pop {
    color: var(--ink);
    background: var(--pop);
    border-color: var(--pop);
  }
  .btn-outline {
    color: var(--fg);
    background: transparent;
  }
  .btn-outline:hover {
    background: var(--fg);
    color: var(--bg);
  }
</style>
