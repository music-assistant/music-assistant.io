---
import Icon from "./Icon.astro";

interface Props {
  id: string;
  title: string;
  code: string;
}
const { id, title, code } = Astro.props;
---

<div class="code-block">
  <div class="head">
    <span>{title}</span>
    <button type="button" class="copy" data-copy-target={id} aria-live="polite">
      <Icon name="copy" size={14} />
      <span data-copy-label>Copy</span>
    </button>
  </div>
  <pre id={id}><code>{code}</code></pre>
</div>

<style>
  .code-block {
    overflow: hidden;
    margin-top: 1rem;
    border: 1px solid #25292d;
    border-radius: var(--radius);
    color: #f2f4f9;
    background: #0b0c0d;
  }
  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.375rem 0.375rem 0.375rem 1rem;
    border-bottom: 1px solid #25292d;
    color: #a3a9b1;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
  .copy {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    height: 1.875rem;
    padding: 0 0.75rem;
    border: 1px solid #34383d;
    border-radius: 0.375rem;
    color: #f2f4f9;
    background: transparent;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    cursor: pointer;
  }
  .copy:hover {
    border-color: #18bcf2;
    color: #18bcf2;
  }
  pre {
    margin: 0;
    padding: 1rem;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.7;
  }
</style>
