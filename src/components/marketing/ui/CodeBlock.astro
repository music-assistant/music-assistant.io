---
import Icon from "./Icon.astro";

interface Props {
  id: string;
  title: string;
  code: string;
}
const { id, title, code } = Astro.props;
---

<div class="code-block">
  <div class="head">
    <span class="title">
      <Icon name="terminal" size={14} />
      {title}
    </span>
    <button type="button" class="copy" data-copy-target={id} aria-live="polite">
      <Icon name="copy" size={14} />
      <span data-copy-label>Copy</span>
    </button>
  </div>
  <pre id={id}><code>{code}</code></pre>
</div>

<style>
  .code-block {
    overflow: hidden;
    margin-top: 1rem;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: var(--code);
  }
  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.375rem 0.375rem 0.375rem 1rem;
    border-bottom: 1px solid var(--border);
    color: var(--muted-foreground);
    font-size: 0.8125rem;
  }
  .title {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
  }
  .copy {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    height: 1.875rem;
    padding: 0 0.75rem;
    border: 0;
    border-radius: 999px;
    color: var(--foreground);
    background: transparent;
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
  }
  .copy:hover {
    background: var(--accent);
  }
  .copy:focus-visible {
    outline: 2px solid var(--ring);
  }
  pre {
    margin: 0;
    padding: 1rem;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.7;
  }
</style>
