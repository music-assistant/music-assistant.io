---
import Icon from "./Icon.astro";

interface Props {
  id: string;
  title: string;
  code: string;
}
const { id, title, code } = Astro.props;
---

<div class="code-block tone-ink">
  <div class="head">
    <span class="title">{title}</span>
    <button type="button" class="copy" data-copy-target={id} aria-live="polite">
      <Icon name="copy" size={14} />
      <span data-copy-label>Copy</span>
    </button>
  </div>
  <pre id={id}><code>{code}</code></pre>
</div>

<style>
  .code-block {
    overflow: hidden;
    margin-top: 1rem;
    border-radius: var(--radius);
  }
  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.375rem 0.375rem 0.375rem 1rem;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
  .copy {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    height: 1.875rem;
    padding: 0 0.75rem;
    border: 0;
    border-radius: var(--radius);
    color: var(--ink);
    background: var(--butter);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    cursor: pointer;
  }
  pre {
    margin: 0;
    padding: 1rem;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.7;
  }
</style>
