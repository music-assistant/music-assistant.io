---
// A screenshot of the app in a plain dark frame. Optional tape strips make it
// look pinned up, like a flyer on a noticeboard.
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  eager?: boolean;
  taped?: boolean;
  class?: string;
}
const {
  src,
  alt,
  width,
  height,
  eager = false,
  taped = false,
  class: className,
} = Astro.props;
---

<figure class:list={["app-window", { taped }, className]}>
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : undefined}
    decoding="async"
  />
</figure>

<style>
  .app-window {
    position: relative;
    margin: 0;
    padding: 0.5rem;
    border-radius: 0.625rem;
    background: #0e0d09;
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.6);
  }
  img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.25rem;
  }
  .taped::before,
  .taped::after {
    content: "";
    position: absolute;
    z-index: 1;
    top: -0.875rem;
    width: 7rem;
    height: 1.75rem;
    background: rgba(245, 195, 59, 0.82);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.15);
  }
  .taped::before {
    left: 8%;
    transform: rotate(-4deg);
  }
  .taped::after {
    right: 8%;
    transform: rotate(3deg);
  }
</style>
