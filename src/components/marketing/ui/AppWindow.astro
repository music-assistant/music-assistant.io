---
// A screenshot of the app in a thin frame. Pass `srcLight` to show the app's
// light theme when the site is in light mode.
interface Props {
  src: string;
  srcLight?: string;
  alt: string;
  width: number;
  height: number;
  eager?: boolean;
  device?: "desktop" | "phone";
  class?: string;
}
const {
  src,
  srcLight,
  alt,
  width,
  height,
  eager = false,
  device = "desktop",
  class: className,
} = Astro.props;
const loading = eager ? "eager" : "lazy";
---

<figure class:list={["app-window", `is-${device}`, className]}>
  <img
    class:list={{ "only-dark": srcLight }}
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    fetchpriority={eager ? "high" : undefined}
    decoding="async"
  />
  {srcLight && (
    <img
      class="only-light"
      src={srcLight}
      alt={alt}
      width={width}
      height={height}
      loading={loading}
      decoding="async"
    />
  )}
</figure>

<style>
  .app-window {
    margin: 0;
    padding: 0.375rem;
    border: 1px solid var(--line);
    border-radius: 0.875rem;
    background: color-mix(in srgb, var(--fg) 4%, var(--bg));
    box-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.6);
  }
  img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.5rem;
  }
  .is-phone {
    padding: 0.3rem;
    border-radius: 1.75rem;
  }
  .is-phone img {
    border-radius: 1.5rem;
  }
</style>
