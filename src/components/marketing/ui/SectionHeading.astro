---
// Section title in the app's "Title  · meta" style, with an optional lead
// paragraph and an action link aligned to the end, like "See all" rows.
interface Props {
  id?: string;
  title: string;
  lead?: string;
  align?: "start" | "center";
}
const { id, title, lead, align = "start" } = Astro.props;
const hasAction = Astro.slots.has("action");
---

<header class:list={["section-heading", `align-${align}`]} data-reveal>
  <div class="text">
    <h2 id={id}>{title}</h2>
    {lead && <p class="lead">{lead}</p>}
  </div>
  {hasAction && (
    <div class="action">
      <slot name="action" />
    </div>
  )}
</header>

<style>
  .section-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .align-center {
    justify-content: center;
    text-align: center;
  }
  .align-center .lead {
    margin-inline: auto;
  }
  h2 {
    margin: 0;
    max-width: 18ch;
  }
  .align-center h2 {
    max-width: none;
  }
  .lead {
    margin: 1rem 0 0;
    max-width: 56ch;
    color: var(--muted-foreground);
    font-size: 1.125rem;
  }
</style>
