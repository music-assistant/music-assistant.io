---
import type { Brand } from "../../../data/marketing";

interface Props {
  brand: Brand;
}
const { brand } = Astro.props;
---

<li class:list={["brand-tile", { "is-dark": brand.dark }]} title={brand.name}>
  <img
    src={`/assets/landing/brands/${brand.icon}.svg`}
    alt={brand.name}
    width="28"
    height="28"
    loading="lazy"
    decoding="async"
  />
</li>

<style>
  .brand-tile {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg);
    transition: border-color 0.2s;
  }
  .brand-tile:hover {
    border-color: var(--accent);
  }
  img {
    width: 55%;
    height: 55%;
    object-fit: contain;
  }
  /* Black logos would vanish on the dark theme. */
  :global(:root:not([data-theme="light"])) .is-dark img {
    filter: invert(1) hue-rotate(180deg);
  }
  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme])) .is-dark img {
      filter: none;
    }
  }
</style>
