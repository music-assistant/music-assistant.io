---
import type { Brand } from "../../../data/marketing";

// A provider logo on a small paper square, like a patch on a jacket.
interface Props {
  brand: Brand;
}
const { brand } = Astro.props;
---

<li class="brand-tile" title={brand.name}>
  <img
    src={`/assets/landing/brands/${brand.icon}.svg`}
    alt={brand.name}
    width="28"
    height="28"
    loading="lazy"
    decoding="async"
  />
</li>

<style>
  .brand-tile {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    border: 1.5px solid var(--line);
    border-radius: var(--radius);
    background: #fff;
    transition: transform 0.2s;
  }
  .brand-tile:nth-child(3n) {
    transform: rotate(-3deg);
  }
  .brand-tile:nth-child(4n + 1) {
    transform: rotate(2deg);
  }
  .brand-tile:hover {
    transform: rotate(0) scale(1.08);
  }
  img {
    width: 58%;
    height: 58%;
    object-fit: contain;
  }
</style>
