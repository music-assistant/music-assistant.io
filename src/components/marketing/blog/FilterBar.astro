---
/**
 * Filter bar for the blog listing pages: quick topic chips, plus a "Filters"
 * button that opens a drawer with every facet (topic, author, year). The drawer
 * slides in from the right on wide screens and up from the bottom as a sheet on
 * narrow ones.
 *
 * Every filter is a plain link to its own listing page (/blog/tags/<tag>/,
 * /blog/authors/<author>/, /blog/<year>/), so filtered views can be shared and
 * crawled and work without JavaScript. One filter is active at a time.
 */
import type { BlogFacets, Facet, ListingKind } from "../../../utils/blog";
import Icon from "../ui/Icon.astro";

interface Props {
  facets: BlogFacets;
  current: { kind: ListingKind; slug: string };
}

const { facets, current } = Astro.props;

const isCurrent = (facet: Facet) =>
  facet.kind === current.kind && facet.slug === current.slug;
const ariaCurrent = (facet: Facet) => (isCurrent(facet) ? "page" : undefined);

// Author and year filters are not in the chip row, so show them there as an
// applied filter that can be removed.
const applied =
  current.kind === "author"
    ? facets.authors.find(isCurrent)
    : current.kind === "year"
      ? facets.years.find(isCurrent)
      : undefined;
const appliedLabel = applied
  ? `${current.kind === "author" ? "Author" : "Year"}: ${applied.label}`
  : undefined;
const activeCount = current.kind === "all" ? 0 : 1;

const sections = [
  { title: "Topic", items: [facets.all, ...facets.tags] },
  { title: "Author", items: facets.authors },
  { title: "Year", items: facets.years },
].filter((section) => section.items.length > 0);
---

<div class="toolbar">
  <nav class="chips" aria-label="Blog topics">
    {/* The applied filter comes first: on phones the row scrolls sideways, and
        a chip at its end would start off-screen. */}
    {applied && (
      <a
        class="chip applied"
        href="/blog/"
        aria-label={`Remove filter ${appliedLabel}`}
      >
        {appliedLabel}
        <Icon name="x" size={14} />
      </a>
    )}
    {[facets.all, ...facets.tags].map((facet) => (
      <a class="chip" href={facet.href} aria-current={ariaCurrent(facet)}>
        {facet.label}
        <span class="count">{facet.count}</span>
      </a>
    ))}
  </nav>
  <div class="actions">
    <button
      type="button"
      class="action filters-button"
      commandfor="blog-filters"
      command="show-modal"
    >
      <Icon name="sliders-horizontal" size={16} />
      Filters
      {activeCount > 0 && (
        <span class="badge" aria-label={`${activeCount} active`}>
          {activeCount}
        </span>
      )}
    </button>
    <a class="action rss" href="/blog/rss.xml">
      <Icon name="rss" size={16} />
      <span>RSS</span>
    </a>
  </div>
</div>

<dialog
  id="blog-filters"
  class="drawer"
  closedby="any"
  aria-labelledby="blog-filters-title"
>
  <header class="drawer-header">
    <h2 id="blog-filters-title">Filter posts</h2>
    <button
      type="button"
      class="close"
      commandfor="blog-filters"
      command="close"
      aria-label="Close filters"
    >
      <Icon name="x" size={20} />
    </button>
  </header>
  <div class="drawer-body">
    {sections.map((section) => (
      <section>
        <h3>{section.title}</h3>
        <ul>
          {section.items.map((facet) => (
            <li>
              <a href={facet.href} aria-current={ariaCurrent(facet)}>
                {facet.picture && (
                  <img
                    src={facet.picture}
                    alt=""
                    width="24"
                    height="24"
                    loading="lazy"
                  />
                )}
                <span class="label">{facet.label}</span>
                <span class="count">{facet.count}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
  <footer class="drawer-footer">
    {activeCount > 0 ? <a href="/blog/">Clear filter</a> : <span />}
    <button
      type="button"
      class="done"
      commandfor="blog-filters"
      command="close"
    >
      Done
    </button>
  </footer>
</dialog>

<script>
  // Invoker commands (commandfor/command) open and close the drawer natively.
  // Browsers without them get the same behaviour from a click handler.
  if (!("commandForElement" in HTMLButtonElement.prototype)) {
    document.addEventListener("click", (event) => {
      const button = (event.target as Element | null)?.closest<HTMLButtonElement>(
        "button[commandfor]",
      );
      if (!button) return;
      const dialog = document.getElementById(
        button.getAttribute("commandfor") ?? "",
      );
      if (!(dialog instanceof HTMLDialogElement)) return;
      const command = button.getAttribute("command");
      if (command === "show-modal") dialog.showModal();
      else if (command === "close") dialog.close();
    });
  }

  // closedby="any" closes the drawer on a backdrop click; not every browser
  // supports it yet.
  if (!("closedBy" in HTMLDialogElement.prototype)) {
    const dialog = document.getElementById("blog-filters");
    if (dialog instanceof HTMLDialogElement) {
      dialog.addEventListener("click", (event) => {
        if (event.target !== dialog) return;
        const rect = dialog.getBoundingClientRect();
        const inside =
          rect.top <= event.clientY &&
          event.clientY <= rect.bottom &&
          rect.left <= event.clientX &&
          event.clientX <= rect.right;
        if (!inside) dialog.close();
      });
    }
  }
</script>

<style>
  .toolbar {
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .chips {
    display: flex;
    gap: 0.5rem;
    min-width: 0;
    /* On narrow screens the chips scroll sideways instead of wrapping. */
    overflow-x: auto;
    scrollbar-width: none;
  }

  .chip {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.875rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition:
      border-color 0.15s,
      color 0.15s;
  }

  .chip[aria-current="page"],
  .chip.applied {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--on-accent);
  }

  .count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    opacity: 0.7;
  }

  .actions {
    display: flex;
    flex-shrink: 0;
    gap: 0.5rem;
    margin-inline-start: auto;
  }

  .action {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.875rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: transparent;
    color: var(--fg);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition: border-color 0.15s;
  }

  .badge {
    display: inline-grid;
    place-items: center;
    min-width: 1.25rem;
    height: 1.25rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 0.75rem;
  }

  /* Hover styles only where a pointer can hover: touch browsers keep :hover on
     the last tapped element, which would leave a drawer row highlighted. */
  @media (hover: hover) {
    .chip:not([aria-current="page"], .applied):hover {
      border-color: var(--accent);
      color: var(--fg);
    }
    .action:hover {
      border-color: var(--accent);
    }
    .close:hover {
      color: var(--fg);
    }
    .drawer-body a:not([aria-current="page"]):hover {
      background: var(--page-alt);
      color: var(--fg);
    }
  }

  @media (max-width: 640px) {
    /* nowrap: in a wrapping column the items stretch to the widest one (the
       full chip row) rather than the container, which pushes the page wider
       than the screen. */
    .toolbar {
      flex-direction: column-reverse;
      flex-wrap: nowrap;
      align-items: stretch;
    }
    .actions {
      margin-inline-start: 0;
    }
    .filters-button {
      flex-grow: 1;
      justify-content: center;
    }
    .rss span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  /* A modal dialog does not stop the page behind it scrolling, so lock it while
     the drawer is open. scrollbar-gutter stops the layout shifting when the
     scrollbar goes. */
  :global(html:has(#blog-filters[open])) {
    overflow: hidden;
    scrollbar-gutter: stable;
  }

  /* Drawer: a side sheet on wide screens, a bottom sheet on narrow ones. */
  .drawer {
    width: min(24rem, 100%);
    max-width: 100%;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0 0 0 auto;
    padding: 0;
    border: 0;
    border-inline-start: 1px solid var(--line);
    background: var(--page);
    color: var(--fg);
    overscroll-behavior: contain;
    box-shadow: 0 1.5rem 4rem rgb(0 0 0 / 0.35);
    opacity: 0;
    transition-property: opacity, transform, display, overlay;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
    transition-behavior: allow-discrete;
  }

  .drawer[open] {
    display: flex;
    flex-direction: column;
    opacity: 1;

    @starting-style {
      opacity: 0;
    }
  }

  .drawer::backdrop {
    background-color: rgb(0 0 0 / 0);
    transition-property: background-color, display, overlay;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
    transition-behavior: allow-discrete;
  }

  .drawer[open]::backdrop {
    background-color: rgb(0 0 0 / 0.5);

    @starting-style {
      background-color: rgb(0 0 0 / 0);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .drawer {
      transform: translateX(100%);
    }
    .drawer[open] {
      transform: none;

      @starting-style {
        transform: translateX(100%);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .drawer,
    .drawer::backdrop {
      transition-duration: 0.1s;
    }
  }

  @media (max-width: 640px) {
    .drawer {
      width: 100%;
      height: auto;
      max-height: 85dvh;
      margin: auto 0 0;
      border-inline-start: 0;
      border-top: 1px solid var(--line);
      border-radius: 1rem 1rem 0 0;
    }

    @media (prefers-reduced-motion: no-preference) {
      .drawer {
        transform: translateY(100%);
      }
      .drawer[open] {
        transform: none;

        @starting-style {
          transform: translateY(100%);
        }
      }
    }
  }

  .drawer-header,
  .drawer-footer {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
  }

  .drawer-header {
    border-bottom: 1px solid var(--line);
  }

  .drawer-header h2 {
    margin: 0;
    font-size: 1.125rem;
  }

  .close {
    display: grid;
    place-items: center;
    padding: 0.25rem;
    border: 0;
    border-radius: 0.375rem;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }

  /* The list scrolls; the header and footer stay in reach. */
  .drawer-body {
    flex-grow: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0.5rem 1.25rem 1rem;
  }

  .drawer-body h3 {
    margin: 1rem 0 0.5rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .drawer-body ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .drawer-body a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 0.75rem;
    border-radius: var(--radius);
    color: var(--fg);
    text-decoration: none;
  }

  .drawer-body a[aria-current="page"] {
    background: var(--accent);
    color: var(--on-accent);
  }

  .drawer-body img {
    border-radius: 50%;
  }

  .drawer-body .label {
    flex-grow: 1;
  }

  .drawer-footer {
    border-top: 1px solid var(--line);
  }

  .drawer-footer a {
    color: var(--link);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .done {
    padding: 0.5rem 1.25rem;
    border: 0;
    border-radius: var(--radius);
    background: var(--accent);
    color: var(--on-accent);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
</style>
