---
import { Swiper, SwiperWrapper, SwiperPagination, SwiperButtonPrev, SwiperButtonNext } from 'astro-swiper';
interface Breakpoint {
	slidesPerView?: number | 'auto';
	spaceBetween?: number;
}

interface Props {
	slidesPerView?: number | 'auto';
	spaceBetween?: number;
	loop?: boolean;
	pagination?: boolean;
	navigation?: boolean;
	autoplay?: boolean | number;
	centeredSlides?: boolean;
	breakpoints?: Record<string, Breakpoint>;
	class?: string;
}

const {
	slidesPerView = 1,
	spaceBetween = 0,
	loop = false,
	pagination = false,
	navigation = false,
	autoplay = false,
	centeredSlides = false,
	breakpoints,
	class: className = '',
} = Astro.props;

const swiperOptions = {
	slidesPerView: slidesPerView,
	spaceBetween: spaceBetween,
	loop: loop,
	centeredSlides: centeredSlides,
	breakpoints: breakpoints,
	pagination: pagination
		? { el: ".swiper-pagination",clickable: true }
		: false,
	navigation: navigation
		? {
				nextEl: '.swiper-button-next',
				prevEl: '.swiper-button-prev',
			}
		: false,
	autoplay:
		typeof autoplay === 'number'
			? { delay: autoplay }
			: autoplay
				? { delay: 3000 }
				: false,
}

---

<div class:list={['ma-swiper', className]}>
	<Swiper options={swiperOptions}>
		<SwiperWrapper>
			<slot />
		</SwiperWrapper>
		{pagination && <SwiperPagination />}
		{
			navigation && (
				<>
					<SwiperButtonPrev />
					<SwiperButtonNext />
				</>
			)
		}
	</div>
</div>

<style is:global>
	.ma-swiper {
		--swiper-theme-color: var(--sl-color-accent);
		--swiper-navigation-color: var(--sl-color-accent);
		--swiper-pagination-color: var(--sl-color-accent);
		--swiper-pagination-bullet-inactive-color: var(--sl-color-gray-4);
		--swiper-pagination-bullet-inactive-opacity: 0.6;
		--swiper-pagination-bullet-size: 10px;
		--swiper-pagination-bullet-horizontal-gap: 6px;
		--swiper-pagination-bottom: 0;
		--swiper-navigation-size: 40px;
		margin-block: 1.5rem;
	}
	.ma-swiper .swiper {
		padding-bottom: 2rem;
	}
	.ma-swiper .swiper-slide {
		display: flex;
		align-items: center;
		justify-content: center;
		height: auto;
	}
	.ma-swiper .swiper-slide img {
		display: block;
		max-width: 100%;
		height: auto;
		border-radius: 0.5rem;
	}
	.ma-swiper .swiper-button-prev,
	.ma-swiper .swiper-button-next {
		background-color: var(--sl-color-bg);
		border-radius: 100%;
		transition: background-color 0.15s ease, border-color 0.15s ease;
	}
	.ma-swiper .swiper-button-prev:hover,
	.ma-swiper .swiper-button-next:hover {
		background-color: var(--sl-color-accent-high);
		border-color: var(--sl-color-accent);
		color: #ffffff;
	}
	.ma-swiper .swiper-navigation-icon {
		height: 60%;
	}
	.ma-swiper .swiper-pagination {
		margin: 0;
	}
	.ma-swiper .swiper-pagination-bullet-active {
		background-color: var(--sl-color-accent);
	}
</style>
