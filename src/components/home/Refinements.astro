---
import { refinements } from "../../data/marketing";
import Icon from "../marketing/ui/Icon.astro";
import SectionHeading from "../marketing/ui/SectionHeading.astro";
import Section from "../marketing/ui/Section.astro";
---

<Section id="setlist" tone="butter" labelledby="setlist-title">
  <div class="container layout">
    <SectionHeading
      id="setlist-title"
      label="Track 04 · The details"
      title="Fine-tune your everyday listening."
    />

    <!-- A setlist taped to the stage floor. Native <details> sharing a name
         open one at a time. -->
    <div class="sheet" data-reveal>
      <p class="sheet-head">
        <span>Setlist</span>
        <span>Music Assistant · Every night</span>
      </p>
      {refinements.map((item, index) => (
        <details name="setlist" open={index === 0}>
          <summary>
            <span class="num">{index + 1}</span>
            <span class="song">
              <strong>{item.title}</strong>
              <span>{item.summary}</span>
            </span>
            <span class="toggle" aria-hidden="true"></span>
          </summary>
          <div class="detail">
            <p>{item.text}</p>
            {item.link && (
              <a class="text-link" href={item.link.href}>
                {item.link.label}
                <Icon name="arrow-right" size={16} />
              </a>
            )}
          </div>
        </details>
      ))}
    </div>
  </div>
</Section>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    align-items: start;
    gap: 2rem clamp(2rem, 6vw, 5rem);
  }
  .layout :global(.section-heading) {
    position: sticky;
    top: calc(var(--header-height) + 2rem);
  }
  .sheet {
    --bg: #fbf8f1;
    --fg: var(--ink);
    --muted: rgba(23, 21, 15, 0.68);
    --line: rgba(23, 21, 15, 0.14);
    --pop: var(--coral);
    position: relative;
    padding: 1.5rem clamp(1.25rem, 3vw, 2.25rem) 1rem;
    color: var(--fg);
    background: var(--bg);
    box-shadow: 0 20px 40px -24px rgba(23, 21, 15, 0.55);
    transform: rotate(-0.75deg);
  }
  .sheet::before {
    content: "";
    position: absolute;
    top: -0.875rem;
    left: 50%;
    width: 8rem;
    height: 1.75rem;
    background: rgba(24, 188, 242, 0.55);
    transform: translateX(-50%) rotate(2deg);
  }
  .sheet-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--ink);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
  }
  .sheet-head span:first-child {
    font-weight: 700;
  }
  details + details {
    border-top: 1px dashed var(--line);
  }
  summary {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 0;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .num {
    flex: none;
    width: 2rem;
    color: var(--coral);
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 800;
    font-stretch: 75%;
    line-height: 1;
  }
  .song {
    display: grid;
    flex: 1;
    min-width: 0;
    line-height: 1.3;
  }
  .song strong {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.2vw, 1.625rem);
    font-weight: 800;
    font-stretch: 80%;
    text-transform: uppercase;
    transition: transform 0.2s;
  }
  summary:hover .song strong {
    transform: translateX(4px);
  }
  .song span {
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .toggle {
    position: relative;
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    border: 2px solid var(--ink);
    border-radius: 50%;
  }
  .toggle::before,
  .toggle::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0.625rem;
    height: 2px;
    background: var(--ink);
    transform: translate(-50%, -50%);
    transition: transform 0.2s;
  }
  .toggle::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }
  details[open] .toggle {
    background: var(--ink);
  }
  details[open] .toggle::before,
  details[open] .toggle::after {
    background: var(--paper);
  }
  details[open] .toggle::after {
    transform: translate(-50%, -50%) rotate(0);
  }
  .detail {
    padding: 0 0 1.25rem 3rem;
  }
  .detail p {
    max-width: 60ch;
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
    }
    .layout :global(.section-heading) {
      position: static;
      margin-bottom: 1rem;
    }
  }
  @media (max-width: 480px) {
    .detail {
      padding-left: 0;
    }
  }
</style>
