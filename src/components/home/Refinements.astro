---
import { refinements } from "../../data/marketing";
import Cover from "../marketing/ui/Cover.astro";
import Icon from "../marketing/ui/Icon.astro";
import Section from "../marketing/ui/Section.astro";
import SectionHeading from "../marketing/ui/SectionHeading.astro";
---

<Section id="setlist" tone="alt" labelledby="setlist-title">
  <div class="container layout">
    <SectionHeading
      id="setlist-title"
      track="04"
      label="Setlist"
      title="Fine-tune your everyday listening."
    />

    <!-- A setlist: numbered songs, one opened at a time. Native <details>
         sharing a name behave as an accordion. -->
    <div class="list" data-reveal>
      {refinements.map((item, index) => (
        <details name="setlist" open={index === 0}>
          <summary>
            <span class="thumb">
              <Cover palette={item.cover} />
              <span class="num">{String(index + 1).padStart(2, "0")}</span>
            </span>
            <span class="song">
              <strong>{item.title}</strong>
              <span>{item.summary}</span>
            </span>
            <span class="toggle" aria-hidden="true"></span>
          </summary>
          <div class="detail">
            <p>{item.text}</p>
            {item.link && (
              <a class="text-link" href={item.link.href}>
                {item.link.label}
                <Icon name="arrow-right" size={16} />
              </a>
            )}
          </div>
        </details>
      ))}
    </div>
  </div>
</Section>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: start;
    gap: 1rem clamp(2rem, 6vw, 5rem);
  }
  .layout :global(.section-heading) {
    position: sticky;
    top: calc(var(--header-height) + 2rem);
  }
  .list {
    border-top: 1px solid var(--line);
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.25rem 0;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  /* Each row gets a small cover, like a track in the app's queue. */
  .thumb {
    position: relative;
    flex: none;
    width: 3rem;
  }
  .thumb :global(.cover) {
    border-radius: 0.375rem;
    filter: saturate(0.35) brightness(0.8);
    transition: filter 0.3s;
  }
  details[open] .thumb :global(.cover),
  summary:hover .thumb :global(.cover) {
    filter: none;
  }
  .num {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
  }
  .song {
    display: grid;
    flex: 1;
    min-width: 0;
    line-height: 1.3;
  }
  .song strong {
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    transition: color 0.15s;
  }
  summary:hover .song strong {
    color: var(--accent);
  }
  .song span {
    margin-top: 0.125rem;
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .toggle {
    position: relative;
    flex: none;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--line);
    border-radius: 50%;
    transition:
      border-color 0.15s,
      background-color 0.15s;
  }
  .toggle::before,
  .toggle::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0.625rem;
    height: 1.5px;
    background: var(--fg);
    transform: translate(-50%, -50%);
    transition: transform 0.2s;
  }
  .toggle::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }
  summary:hover .toggle {
    border-color: var(--fg);
  }
  details[open] .toggle {
    border-color: var(--accent);
    background: var(--accent);
  }
  details[open] .toggle::before,
  details[open] .toggle::after {
    background: var(--on-accent);
  }
  details[open] .toggle::after {
    transform: translate(-50%, -50%) rotate(0);
  }
  .detail {
    padding: 0 3.25rem 1.5rem 4.25rem;
  }
  .detail p {
    max-width: 60ch;
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
    }
    .layout :global(.section-heading) {
      position: static;
    }
  }
  @media (max-width: 480px) {
    .detail {
      padding-inline: 0;
    }
  }
</style>
