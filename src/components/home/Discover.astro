---
import AppWindow from "../marketing/ui/AppWindow.astro";
import Icon from "../marketing/ui/Icon.astro";

const points = [
  {
    icon: "disc-3",
    text: "Browse new releases and rediscover favorites without jumping between apps.",
  },
  {
    icon: "list-filter",
    text: "Build smart playlists that follow your own rules.",
    href: "/plugins/smart_playlist/",
  },
  {
    icon: "audio-waveform",
    text: "Find songs that sound like a favorite.",
    href: "/plugins/sonic-similarity/",
  },
];
---

<section
  id="experience"
  class="section discover"
  aria-labelledby="discover-title"
>
  <div class="container layout">
    <div class="copy" data-reveal>
      <h2 id="discover-title">Get lost in the music.</h2>
      <p class="lead">
        One place to find what to play next, whichever service it comes from.
      </p>
      <ul>
        {points.map((point) => (
          <li>
            <span class="point-icon">
              <Icon name={point.icon} size={18} />
            </span>
            <span>
              {point.text}
              {point.href && (
                <>
                  {" "}
                  <a class="text-link" href={point.href}>
                    Learn more
                  </a>
                </>
              )}
            </span>
          </li>
        ))}
      </ul>
    </div>
    <div data-reveal style="--reveal-delay: 120ms">
      <AppWindow
        src="/assets/landing/discover-page.webp"
        alt="Music Assistant's Discover page with personalized picks, new tracks and albums"
        width={800}
        height={435}
      />
    </div>
  </div>
</section>

<style>
  .discover {
    background: var(--card);
    border-block: 1px solid var(--border);
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
  }
  .lead {
    color: var(--muted-foreground);
    font-size: 1.125rem;
  }
  ul {
    display: grid;
    gap: 1rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }
  li {
    display: flex;
    gap: 1rem;
    align-items: start;
  }
  .point-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.625rem;
    background: var(--primary-soft);
    color: var(--primary-strong);
  }
  li > span:last-child {
    padding-top: 0.375rem;
  }
  @media (max-width: 860px) {
    .layout {
      grid-template-columns: 1fr;
    }
  }
</style>
