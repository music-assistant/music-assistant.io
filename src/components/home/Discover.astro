---
import AppWindow from "../marketing/ui/AppWindow.astro";
import Section from "../marketing/ui/Section.astro";

const points = [
  {
    text: "Browse new releases and rediscover favorites without jumping between apps.",
  },
  {
    text: "Build smart playlists that follow your own rules.",
    href: "/plugins/smart_playlist/",
  },
  {
    text: "Find songs that sound like a favorite.",
    href: "/plugins/sonic-similarity/",
  },
];
---

<Section id="experience" tone="ink" labelledby="discover-title">
  <div class="container layout">
    <div class="copy" data-reveal>
      <p class="liner">Track 03 · Discover</p>
      <h2 id="discover-title">Get lost in the music.</h2>
      <p class="lead">
        One place to find what to play next, whichever service it comes from.
      </p>
      <ol>
        {points.map((point) => (
          <li>
            {point.text}
            {point.href && (
              <>
                {" "}
                <a class="text-link" href={point.href}>
                  Learn more
                </a>
              </>
            )}
          </li>
        ))}
      </ol>
    </div>
    <div class="shot" data-reveal style="--reveal-delay: 120ms">
      <AppWindow
        src="/assets/landing/discover-page.webp"
        alt="Music Assistant's Discover page with personalized picks, new tracks and albums"
        width={800}
        height={435}
        taped
      />
    </div>
  </div>
</Section>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: center;
    gap: clamp(2.5rem, 6vw, 5rem);
  }
  .liner {
    color: var(--muted);
  }
  .lead {
    color: var(--muted);
    font-size: 1.1875rem;
  }
  ol {
    display: grid;
    gap: 0;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
    counter-reset: point;
  }
  li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    padding: 1rem 0;
    border-top: 1px solid var(--line);
    counter-increment: point;
  }
  li::before {
    content: counter(point, decimal-leading-zero);
    color: var(--butter);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.9;
  }
  li .text-link {
    grid-column: 2;
    justify-self: start;
    margin-top: 0.25rem;
    color: var(--butter);
  }
  .shot {
    transform: rotate(1.5deg);
  }
  @media (max-width: 860px) {
    .layout {
      grid-template-columns: 1fr;
    }
  }
</style>
