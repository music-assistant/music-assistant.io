---
import AppWindow from "../marketing/ui/AppWindow.astro";
import Section from "../marketing/ui/Section.astro";

const points = [
  {
    text: "Browse new releases and rediscover favorites without jumping between apps.",
  },
  {
    text: "Build smart playlists that follow your own rules.",
    href: "/plugins/smart_playlist/",
  },
  {
    text: "Find songs that sound like a favorite.",
    href: "/plugins/sonic-similarity/",
  },
];
---

<Section id="experience" tone="base" labelledby="discover-title">
  <div class="container layout">
    <div class="copy" data-reveal>
      <p class="eyebrow">
        <b>03</b> Discover
      </p>
      <h2 id="discover-title">Get lost in the music.</h2>
      <p class="lead">
        One place to find what to play next, whichever service it comes from.
      </p>
      <ol>
        {points.map((point) => (
          <li>
            <span>{point.text}</span>
            {point.href && (
              <a class="text-link" href={point.href}>
                Learn more
              </a>
            )}
          </li>
        ))}
      </ol>
    </div>
    <div class="shots" data-reveal style="--reveal-delay: 120ms">
      <AppWindow
        src="/assets/landing/albums-dark.webp"
        srcLight="/assets/landing/albums-light.webp"
        alt="The album library in Music Assistant, a grid of album covers"
        width={1800}
        height={1125}
      />
      <AppWindow
        src="/assets/landing/now-playing-mobile-dark.webp"
        srcLight="/assets/landing/now-playing-mobile-light.webp"
        alt="Now playing on a phone, with the album cover, progress and playback controls"
        width={640}
        height={1385}
        device="phone"
        class="phone"
      />
    </div>
  </div>
</Section>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: center;
    gap: clamp(2.5rem, 6vw, 5rem);
  }
  .lead {
    color: var(--muted);
    font-size: 1.1875rem;
  }
  ol {
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
    counter-reset: point;
  }
  li {
    display: grid;
    grid-template-columns: 2.75rem 1fr;
    padding: 1rem 0;
    border-top: 1px solid var(--line);
    counter-increment: point;
  }
  li::before {
    content: counter(point, decimal-leading-zero);
    grid-row: span 2;
    color: var(--link);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.9;
  }
  li .text-link {
    justify-self: start;
    margin-top: 0.25rem;
  }
  /* The phone overlaps the corner of the desktop screenshot. */
  .shots {
    position: relative;
    padding-bottom: 12%;
    padding-right: 8%;
  }
  .shots :global(.phone) {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 26%;
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.7);
  }
  @media (max-width: 860px) {
    .layout {
      grid-template-columns: 1fr;
    }
  }
</style>
