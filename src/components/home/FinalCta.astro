---
import Button from "../marketing/ui/Button.astro";
import Section from "../marketing/ui/Section.astro";
---

<Section id="get-started" tone="base" labelledby="final-title" class="final">
  <div class="container" data-reveal>
    <p class="eyebrow">
      <b>06</b> Encore
    </p>
    <h2 id="final-title">Bring your music home.</h2>
    <div class="row">
      <p>
        Install Music Assistant on Home Assistant or with Docker, then connect
        your music and speakers.
      </p>
      <div class="actions">
        <Button href="/get-started/" size="lg" trailingIcon="arrow-right">
          Get Music Assistant
        </Button>
        <Button href="/documentation/" variant="secondary" size="lg">
          Read the documentation
        </Button>
      </div>
    </div>
  </div>
</Section>

<style>
  .final {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  .final::before {
    content: "";
    position: absolute;
    z-index: -1;
    right: -10%;
    bottom: -40%;
    width: 70%;
    height: 100%;
    background: radial-gradient(
      50% 50% at 50% 50%,
      color-mix(in srgb, var(--accent) 14%, transparent),
      transparent 70%
    );
  }
  h2 {
    max-width: none;
    font-size: clamp(3.5rem, 10vw, 8.5rem);
    font-weight: 800;
    line-height: 0.85;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    margin-top: 2rem;
  }
  .row p {
    max-width: 30rem;
    margin: 0;
    color: var(--muted);
    font-size: 1.1875rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
