---
import Button from "../marketing/ui/Button.astro";
import Section from "../marketing/ui/Section.astro";
---

<Section id="get-started" tone="paper" labelledby="final-title">
  <div class="container">
    <!-- A gig ticket: the show on the left, the stub with the way in on the right. -->
    <div class="ticket" data-reveal>
      <div class="show tone-ink">
        <p class="liner">Admit one · All ages · Free entry</p>
        <h2 id="final-title">Bring your music home.</h2>
        <p>
          Install Music Assistant on Home Assistant or with Docker, then connect
          your music and speakers.
        </p>
      </div>
      <div class="stub tone-butter">
        <p class="stub-no">No. 0001</p>
        <Button href="/get-started/" size="lg" trailingIcon="arrow-right">
          Get Music Assistant
        </Button>
        <a class="text-link" href="/documentation/">
          Read the documentation
        </a>
      </div>
    </div>
  </div>
</Section>

<style>
  .ticket {
    --notch: 1.25rem;
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(16rem, 1fr);
    filter: drop-shadow(0 24px 30px rgba(23, 21, 15, 0.25));
    transform: rotate(-1deg);
  }
  .show,
  .stub {
    padding: clamp(1.75rem, 4vw, 3rem);
  }
  .show {
    border-radius: 0.75rem 0 0 0.75rem;
    /* Half-circle bites where the ticket tears. */
    mask:
      radial-gradient(circle var(--notch) at 100% 0, transparent 98%, #000)
        top / 100% 51% no-repeat,
      radial-gradient(circle var(--notch) at 100% 100%, transparent 98%, #000)
        bottom / 100% 51% no-repeat;
  }
  .show .liner {
    color: var(--butter);
  }
  .show h2 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
  }
  .show p:last-child {
    max-width: 34rem;
    margin: 0;
    color: var(--muted);
    font-size: 1.125rem;
  }
  .stub {
    display: flex;
    flex-direction: column;
    align-items: start;
    justify-content: center;
    gap: 1.25rem;
    border-left: 3px dashed rgba(23, 21, 15, 0.45);
    border-radius: 0 0.75rem 0.75rem 0;
    mask:
      radial-gradient(circle var(--notch) at 0 0, transparent 98%, #000) top /
        100% 51% no-repeat,
      radial-gradient(circle var(--notch) at 0 100%, transparent 98%, #000)
        bottom / 100% 51% no-repeat;
  }
  .stub-no {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.1em;
  }
  @media (max-width: 760px) {
    .ticket {
      grid-template-columns: 1fr;
      transform: none;
    }
    .show,
    .stub {
      mask: none;
    }
    .show {
      border-radius: 0.75rem 0.75rem 0 0;
    }
    .stub {
      border-left: 0;
      border-top: 3px dashed rgba(23, 21, 15, 0.45);
      border-radius: 0 0 0.75rem 0.75rem;
    }
  }
</style>
