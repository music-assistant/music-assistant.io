---
import { heroPlayers } from "../../data/marketing";
import AppWindow from "../marketing/ui/AppWindow.astro";
import Button from "../marketing/ui/Button.astro";
import Icon from "../marketing/ui/Icon.astro";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="glow" aria-hidden="true"></div>
  <div class="container">
    <div class="copy">
      <p class="badge">
        <Icon name="house" size={14} />
        <span>
          Free and open source
          <span class="wide"> · A project of the Open Home Foundation</span>
        </span>
      </p>
      <h1 id="hero-title">
        Your music. <span>Your way.</span>
      </h1>
      <p class="lead">
        Bring your streaming services and your own files into one library, and
        play them on almost any speaker in your home.
      </p>
      <div class="actions">
        <Button href="/get-started/" size="lg" trailingIcon="arrow-right">
          Get Music Assistant
        </Button>
        <Button href="#how-it-works" variant="tonal" size="lg">
          See how it works
        </Button>
      </div>
    </div>

    <div class="product">
      <AppWindow
        src="/assets/landing/discover.webp"
        alt="Music Assistant's Discover screen, with players, top picks and similar artists"
        width={1911}
        height={1027}
        eager
      />

      <ul
        class="players"
        aria-label="Example speakers playing from Music Assistant"
      >
        {heroPlayers.map((player) => (
          <li class:list={["player", { playing: player.playing }]}>
            <span class="player-icon">
              {player.playing ? (
                <span class="eq" aria-hidden="true">
                  <i></i>
                  <i></i>
                  <i></i>
                </span>
              ) : (
                <Icon name={player.icon} size={18} />
              )}
            </span>
            <span class="player-text">
              <strong>{player.name}</strong>
              <span>
                {player.playing
                  ? `${player.track} · ${player.artist}`
                  : player.kind}
              </span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(3rem, 8vw, 6rem) 0 clamp(4rem, 8vw, 6rem);
    isolation: isolate;
  }
  /* A soft wash of colour, like the album-art tint on the app's player bar. */
  .glow {
    position: absolute;
    z-index: -1;
    inset: -20% -10% auto;
    height: 80%;
    background:
      radial-gradient(
        40% 50% at 30% 40%,
        color-mix(in srgb, var(--primary) 28%, transparent),
        transparent 70%
      ),
      radial-gradient(
        30% 45% at 72% 35%,
        color-mix(in srgb, var(--tone-purple) 16%, transparent),
        transparent 70%
      ),
      radial-gradient(
        30% 40% at 55% 70%,
        color-mix(in srgb, var(--tone-green) 12%, transparent),
        transparent 70%
      );
    filter: blur(40px);
  }
  .copy {
    max-width: 48rem;
    margin: 0 auto;
    text-align: center;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.75rem;
    padding: 0.375rem 0.875rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--card) 70%, transparent);
    color: var(--muted-foreground);
    font-size: 0.8125rem;
    font-weight: 500;
  }
  .badge :global(.icon) {
    color: var(--primary);
  }
  h1 {
    margin-bottom: 1.5rem;
  }
  h1 span {
    color: var(--primary);
  }
  .lead {
    max-width: 38rem;
    margin: 0 auto 2rem;
    color: var(--muted-foreground);
    font-size: clamp(1.125rem, 2vw, 1.3125rem);
    line-height: 1.5;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .product {
    position: relative;
    max-width: 68rem;
    margin: clamp(3rem, 6vw, 4.5rem) auto 0;
  }

  /* Speakers in the style of the Players row at the top of Discover. */
  .players {
    position: absolute;
    left: 50%;
    bottom: 0;
    display: flex;
    gap: 0.5rem;
    width: max-content;
    max-width: calc(100% - 2rem);
    margin: 0;
    padding: 0.5rem;
    list-style: none;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 1.25rem;
    background: rgba(35, 35, 35, 0.78);
    backdrop-filter: blur(20px) saturate(1.5);
    -webkit-backdrop-filter: blur(20px) saturate(1.5);
    box-shadow: 0 24px 48px -12px rgba(0, 0, 0, 0.6);
    color: #fff;
    transform: translate(-50%, 45%);
  }
  .player {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
    padding: 0.5rem 1rem 0.5rem 0.5rem;
    border-radius: 0.75rem;
    background: rgba(255, 255, 255, 0.04);
  }
  .player.playing {
    background: color-mix(in srgb, var(--primary) 22%, transparent);
  }
  .player-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.5rem;
    background: rgba(255, 255, 255, 0.08);
    color: #a0a0a0;
  }
  .playing .player-icon {
    background: var(--primary);
    color: #fff;
  }
  .player-text {
    display: grid;
    min-width: 0;
    line-height: 1.3;
  }
  .player-text strong {
    font-size: 0.875rem;
    font-weight: 600;
  }
  .player-text span {
    overflow: hidden;
    color: #a0a0a0;
    font-size: 0.75rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .playing .player-text span {
    color: #d7f0fc;
  }

  .eq {
    display: flex;
    align-items: end;
    gap: 3px;
    height: 16px;
  }
  .eq i {
    width: 3px;
    height: 100%;
    border-radius: 2px;
    background: currentColor;
    transform-origin: bottom;
    animation: eq 1s ease-in-out infinite;
  }
  .eq i:nth-child(2) {
    animation-delay: -0.4s;
  }
  .eq i:nth-child(3) {
    animation-delay: -0.7s;
  }
  @keyframes eq {
    0%,
    100% {
      transform: scaleY(0.3);
    }
    50% {
      transform: scaleY(1);
    }
  }

  @media (max-width: 900px) {
    .player:nth-child(n + 3) {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .badge .wide {
      display: none;
    }
    .players {
      position: static;
      width: auto;
      max-width: none;
      margin-top: 0.75rem;
      transform: none;
      flex-direction: column;
    }
  }
</style>
