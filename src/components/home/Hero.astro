---
import AppWindow from "../marketing/ui/AppWindow.astro";
---

<section class="hero tone-base" aria-labelledby="hero-title" data-hero>
  <canvas class="smoke" aria-hidden="true" data-smoke></canvas>
  <div class="container">
    <div class="copy">
      <h1 id="hero-title">
        <span>Your music.</span>
        <span class="way">Your way.</span>
      </h1>
      <p class="lead">
        Bring the music you love – from your personal collection or streaming
        services – into one library, to enjoy on speakers you already own.
      </p>
    </div>

    <div class="product">
      <AppWindow
        src="/assets/landing/discover-dark.webp"
        srcLight="/assets/landing/discover-light.webp"
        alt="Music Assistant's Discover screen: speakers playing in different rooms, top picks and recently played music"
        width={2400}
        height={1500}
        eager
      />
    </div>
  </div>
</section>

<script>
  import { onNowPlaying } from "./now-playing";
  import { startSmoke } from "./smoke";

  const hero = document.querySelector<HTMLElement>("[data-hero]");
  const canvas = document.querySelector<HTMLCanvasElement>("[data-smoke]");

  // Mixes hex colour a toward b by f.
  const mix = (a: string, b: string, f: number) =>
    "#" +
    [1, 3, 5]
      .map((i) => {
        const x = parseInt(a.slice(i, i + 2), 16);
        const y = parseInt(b.slice(i, i + 2), 16);
        return Math.round(x + (y - x) * f)
          .toString(16)
          .padStart(2, "0");
      })
      .join("");

  // The hero takes the playing cover's colours. Each cover's third colour
  // is its deep shadow, nearly invisible as light on a dark page, so it's
  // lifted toward the second.
  const heroColors = ([c1, c2, c3]: string[]) => [c1, c2, mix(c3, c2, 0.45)];
  onNowPlaying((colors) => {
    const [c1, c2, c3] = heroColors(colors);
    [c1, c2, c3, c2].forEach((color, i) =>
      hero?.style.setProperty(`--glow-${i + 1}`, color),
    );
  });

  // The smoke starts once the page has loaded and gone quiet: creating a
  // WebGL context blocks the main thread, so it waits until the hero
  // screenshot has painted.
  const start = () => {
    const smoke = hero && canvas ? startSmoke(hero, canvas, hero.querySelector(".app-window")) : undefined;
    if (smoke) onNowPlaying((colors) => smoke.setColors(heroColors(colors)));
  };
  const whenIdle = () =>
    "requestIdleCallback" in window
      ? requestIdleCallback(start, { timeout: 1500 })
      : setTimeout(start, 300);
  if (document.readyState === "complete") whenIdle();
  else addEventListener("load", whenIdle, { once: true });
</script>

<style>
  @property --glow-1 {
    syntax: "<color>";
    inherits: true;
    initial-value: #9d4edd;
  }
  @property --glow-2 {
    syntax: "<color>";
    inherits: true;
    initial-value: #ff7a18;
  }
  @property --glow-3 {
    syntax: "<color>";
    inherits: true;
    initial-value: #18bcf2;
  }
  @property --glow-4 {
    syntax: "<color>";
    inherits: true;
    initial-value: #ff006e;
  }
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(3rem, 7vw, 5.5rem) 0 clamp(4rem, 8vw, 6rem);
    isolation: isolate;
    transition:
      --glow-1 1.2s ease,
      --glow-2 1.2s ease,
      --glow-3 1.2s ease,
      --glow-4 1.2s ease;
  }
  /* Behind the product, colour bleeds out like light through album art:
     a few hues from the playing cover, drifting slowly. */
  .hero::before {
    content: "";
    position: absolute;
    z-index: -1;
    left: 50%;
    bottom: -8%;
    width: min(1300px, 140%);
    height: 72%;
    background:
      radial-gradient(
        35% 45% at 25% 55%,
        color-mix(in srgb, var(--glow-1) 35%, transparent),
        transparent 70%
      ),
      radial-gradient(
        30% 40% at 55% 40%,
        color-mix(in srgb, var(--glow-2) 28%, transparent),
        transparent 70%
      ),
      radial-gradient(
        30% 45% at 78% 60%,
        color-mix(in srgb, var(--glow-3) 30%, transparent),
        transparent 70%
      ),
      radial-gradient(
        25% 35% at 45% 80%,
        color-mix(in srgb, var(--glow-4) 20%, transparent),
        transparent 70%
      );
    filter: blur(30px);
    transform: translateX(-50%);
    animation: drift 18s ease-in-out infinite alternate;
  }
  /* Browsers without color-mix (Safari before 16.2) get the default
     colours, fixed. */
  @supports not (color: color-mix(in srgb, red 50%, transparent)) {
    .hero::before {
      background:
        radial-gradient(35% 45% at 25% 55%, rgb(157 78 221 / 0.35), transparent 70%),
        radial-gradient(30% 40% at 55% 40%, rgb(255 122 24 / 0.28), transparent 70%),
        radial-gradient(30% 45% at 78% 60%, rgb(24 188 242 / 0.3), transparent 70%),
        radial-gradient(25% 35% at 45% 80%, rgb(255 0 110 / 0.2), transparent 70%);
    }
  }
  @keyframes drift {
    to {
      transform: translateX(-47%) scale(1.06);
      filter: blur(30px) hue-rotate(25deg);
    }
  }
  /* Cursor-stirred smoke over the glow; see smoke.ts. */
  .smoke {
    position: absolute;
    z-index: -1;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    transition: opacity 1.2s ease;
  }
  .smoke:global(.is-ready) {
    opacity: 1;
  }
  h1 {
    margin: 0;
  }
  h1 span {
    display: block;
  }
  .way {
    color: var(--accent);
  }
  .copy {
    text-align: center;
  }
  .lead {
    max-width: 34rem;
    margin: clamp(1.5rem, 3vw, 2.25rem) auto 0;
    color: var(--muted);
    font-size: clamp(1.1875rem, 1.8vw, 1.375rem);
    line-height: 1.5;
  }
  .product {
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }
</style>
