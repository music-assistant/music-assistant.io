---
import AppWindow from "../marketing/ui/AppWindow.astro";
import Button from "../marketing/ui/Button.astro";
---

<section class="hero tone-base" aria-labelledby="hero-title">
  <div class="container">
    <p class="eyebrow">
      <b>●</b> Free and open source · Open Home Foundation
    </p>
    <h1 id="hero-title">
      <span>Your music.</span>
      <span class="way">
        Your way.
        <!-- A marker stroke under the words, drawn once on load. -->
        <svg
          class="scribble"
          viewBox="0 0 400 24"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <path d="M4 16 C 60 6, 120 20, 190 11 S 330 6, 396 13" pathLength="1"></path>
        </svg>
      </span>
    </h1>

    <div class="intro">
      <p class="lead">
        Bring your streaming services and your own files into one library, and
        play them on almost any speaker in your home.
      </p>
      <div class="actions">
        <Button href="/get-started/" size="lg" trailingIcon="arrow-right">
          Get Music Assistant
        </Button>
        <Button href="#how-it-works" variant="secondary" size="lg">
          How it works
        </Button>
      </div>
    </div>

    <div class="product">
      <AppWindow
        src="/assets/landing/discover-dark.webp"
        srcLight="/assets/landing/discover-light.webp"
        alt="Music Assistant's Discover screen: speakers playing in different rooms, top picks and recently played music"
        width={2400}
        height={1500}
        eager
      />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(3rem, 7vw, 5.5rem) 0 clamp(4rem, 8vw, 6rem);
    isolation: isolate;
  }
  /* One cold stage light from above, behind the product. */
  .hero::before {
    content: "";
    position: absolute;
    z-index: -1;
    left: 50%;
    bottom: -10%;
    width: min(1100px, 120%);
    height: 70%;
    background: radial-gradient(
      50% 50% at 50% 50%,
      color-mix(in srgb, var(--accent) 16%, transparent),
      transparent 70%
    );
    transform: translateX(-50%);
  }
  h1 {
    margin: 0;
  }
  h1 span {
    display: block;
  }
  .way {
    position: relative;
    width: fit-content;
    color: var(--accent);
  }
  .scribble {
    position: absolute;
    left: -2%;
    bottom: -0.12em;
    width: 104%;
    height: 0.18em;
    overflow: visible;
  }
  .scribble path {
    fill: none;
    stroke: var(--fg);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    vector-effect: non-scaling-stroke;
    animation: draw 0.9s 0.4s cubic-bezier(0.6, 0, 0.3, 1) forwards;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .scribble path {
      stroke-dashoffset: 0;
    }
  }

  .intro {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  .lead {
    max-width: 32rem;
    margin: 0;
    color: var(--muted);
    font-size: clamp(1.1875rem, 1.8vw, 1.375rem);
    line-height: 1.5;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .product {
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }
</style>
