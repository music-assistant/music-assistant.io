---
import { musicSources, speakers } from "../../data/marketing";

// A quiet running list of what Music Assistant plays from and to, like the
// names printed down the back of a tour shirt.
const names = [...musicSources, ...speakers].map((brand) => brand.name);
---

<div class="marquee tone-alt">
  <p class="sr-only">Works with {names.join(", ")}, and many more.</p>
  <div class="track" aria-hidden="true">
    {[0, 1].map(() => (
      <ul>
        {names.map((name) => (
          <li>{name}</li>
        ))}
      </ul>
    ))}
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    padding: 1.125rem 0;
    border-block: 1px solid var(--line);
    mask: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .track {
    display: flex;
    width: max-content;
    animation: scroll 90s linear infinite;
  }
  .marquee:hover .track {
    animation-play-state: paused;
  }
  ul {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    color: var(--muted);
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }
  li::after {
    content: "/";
    margin: 0 1.25rem;
    color: var(--accent);
  }
  @keyframes scroll {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
    }
  }
</style>
