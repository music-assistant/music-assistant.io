---
import { plugins } from "../../data/marketing";
import Cover from "../marketing/ui/Cover.astro";
import Icon from "../marketing/ui/Icon.astro";
import Section from "../marketing/ui/Section.astro";
import SectionHeading from "../marketing/ui/SectionHeading.astro";
---

<Section id="features" tone="alt" labelledby="plugins-title">
  <div class="container">
    <SectionHeading
      id="plugins-title"
      title="More than pressing play."
    />

    <!-- Set out like the bill on a gig poster: the names in big type. -->
    <ul class="bill">
      {plugins.map((plugin, index) => (
        <li data-reveal style={`--reveal-delay: ${index * 70}ms`}>
          <a href={plugin.href} class="act">
            <span class="headliner">
              <Cover palette={plugin.cover} class="art" />
              <span class="name">{plugin.label}</span>
            </span>
            <span class="detail">
              <strong>{plugin.title}</strong>
              <span>{plugin.text}</span>
              <span class="more">
                {plugin.link} <Icon name="arrow-right" size={16} />
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>

    <p class="also" data-reveal>
      And more: scrobbler, smart playlists, sonic similarity, visualizers.
      <a class="text-link" href="/plugins/">
        All plugins <Icon name="arrow-right" size={16} />
      </a>
    </p>
  </div>
</Section>

<style>
  .bill {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  li {
    border-bottom: 1px solid var(--line);
  }
  .act {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    align-items: center;
    gap: 1rem 3rem;
    padding: clamp(1.25rem, 3vw, 2rem) 0;
    text-decoration: none;
  }
  .headliner {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .headliner :global(.art) {
    flex: none;
    width: clamp(3.5rem, 6vw, 4.5rem);
    box-shadow: 0 12px 24px -12px rgba(0, 0, 0, 0.6);
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .act:hover .headliner :global(.art) {
    transform: rotate(-4deg) scale(1.06);
  }
  .name {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.03em;
    transition:
      color 0.2s,
      transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .act:hover .name,
  .act:focus-visible .name {
    color: var(--accent);
    transform: translateX(0.5rem);
  }
  .detail {
    display: grid;
    gap: 0.375rem;
  }
  .detail strong {
    font-size: 1.125rem;
    font-weight: 600;
  }
  .detail > span:not(.more) {
    color: var(--muted);
    font-size: 0.9875rem;
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 0.25rem;
    color: var(--link);
    font-weight: 600;
  }
  .more :global(.icon) {
    transition: transform 0.15s;
  }
  .act:hover .more :global(.icon) {
    transform: translateX(3px);
  }

  .also {
    margin: 2rem 0 0;
    color: var(--muted);
    font-size: 1rem;
  }
  .also .text-link {
    margin-left: 0.25rem;
  }

  @media (max-width: 760px) {
    .act {
      grid-template-columns: 1fr;
    }
  }
</style>
