---
import { plugins } from "../../data/marketing";
import Icon from "../marketing/ui/Icon.astro";
import SectionHeading from "../marketing/ui/SectionHeading.astro";
---

<section id="features" class="section plugins" aria-labelledby="plugins-title">
  <div class="container">
    <SectionHeading id="plugins-title" title="More than pressing play.">
      <a slot="action" class="text-link" href="/plugins/">
        All plugins <Icon name="arrow-right" size={16} />
      </a>
    </SectionHeading>

    <ul class="grid">
      {plugins.map((plugin, index) => (
        <li
          class="tile"
          data-reveal
          style={`--tone: var(--tone-${plugin.tone}); --reveal-delay: ${index * 80}ms`}
        >
          <a href={plugin.href} class="art" aria-hidden="true" tabindex="-1">
            <span class="label">
              <Icon name="sparkles" size={14} />
              {plugin.label}
            </span>
            <Icon name={plugin.icon} size={96} class="art-icon" />
          </a>
          <div class="body">
            <h3>{plugin.title}</h3>
            <p>{plugin.text}</p>
            <a class="text-link" href={plugin.href}>
              {plugin.link}
              <Icon name="arrow-right" size={16} />
            </a>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tile {
    display: flex;
    flex-direction: column;
  }
  /* Artwork in the manner of the app's Top Picks tiles: a full-bleed image,
     a small sparkle label on top and the subject filling the frame. */
  .art {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 1rem;
    color: #fff;
    background:
      radial-gradient(
        90% 70% at 80% 100%,
        rgba(0, 0, 0, 0.35),
        transparent 70%
      ),
      radial-gradient(
        80% 80% at 20% 10%,
        color-mix(in srgb, var(--tone) 70%, #fff),
        transparent 70%
      ),
      linear-gradient(
        160deg,
        var(--tone),
        color-mix(in srgb, var(--tone) 55%, #000)
      );
    transition:
      transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 0.3s;
  }
  .tile:hover .art {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px -16px
      color-mix(in srgb, var(--tone) 70%, transparent);
  }
  .art :global(.art-icon) {
    width: 42%;
    height: 42%;
    opacity: 0.95;
    stroke-width: 1.5;
    filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.25));
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .tile:hover .art :global(.art-icon) {
    transform: scale(1.06) rotate(-3deg);
  }
  .label {
    position: absolute;
    top: 1rem;
    left: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
  }
  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.25rem 0.25rem 0;
  }
  .body h3 {
    margin-bottom: 0.5rem;
  }
  .body p {
    color: var(--muted-foreground);
    font-size: 0.9375rem;
  }
  .body .text-link {
    margin-top: auto;
  }

  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem 1.25rem;
    }
  }
  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .art {
      aspect-ratio: 16 / 9;
    }
    .art :global(.art-icon) {
      width: auto;
      height: 50%;
    }
  }
</style>
