---
import { plugins } from "../../data/marketing";
import Icon from "../marketing/ui/Icon.astro";
import SectionHeading from "../marketing/ui/SectionHeading.astro";
import Section from "../marketing/ui/Section.astro";
---

<Section id="features" tone="coral" labelledby="plugins-title">
  <div class="container">
    <SectionHeading
      id="plugins-title"
      label="Track 02 · Plugins"
      title="More than pressing play."
    />

    <!-- Laid out like a festival line-up: the headliners in big type. -->
    <ul class="lineup">
      {plugins.map((plugin, index) => (
        <li data-reveal style={`--reveal-delay: ${index * 70}ms`}>
          <a href={plugin.href} class="act">
            <span class="name">{plugin.label}</span>
            <span class="detail">
              <strong>{plugin.title}</strong>
              <span>{plugin.text}</span>
              <span class="more">
                {plugin.link} <Icon name="arrow-right" size={16} />
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>

    <p class="also" data-reveal>
      <span class="also-label">Also appearing</span>
      Smart playlists ✦ Sonic similarity ✦ Spotify Connect ✦ Scrobbling ✦
      Visualizers ✦{" "}
      <a class="text-link" href="/plugins/">
        and more <Icon name="arrow-right" size={16} />
      </a>
    </p>
  </div>
</Section>

<style>
  .lineup {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 2px solid var(--ink);
  }
  li {
    border-bottom: 2px solid var(--ink);
  }
  .act {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    align-items: center;
    gap: 1rem 3rem;
    padding: clamp(1.25rem, 3vw, 2rem) 0;
    text-decoration: none;
  }
  .name {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 8vw, 6.5rem);
    font-weight: 800;
    font-stretch: 75%;
    line-height: 0.9;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    transition:
      transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1),
      color 0.2s;
  }
  .act:hover .name,
  .act:focus-visible .name {
    color: var(--paper);
    transform: translateX(0.75rem);
  }
  .detail {
    display: grid;
    gap: 0.375rem;
  }
  .detail strong {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-stretch: 90%;
    line-height: 1.15;
  }
  .detail > span:not(.more) {
    color: var(--muted);
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 0.25rem;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .act:hover .more :global(.icon) {
    transform: translateX(3px);
  }
  .more :global(.icon) {
    transition: transform 0.15s;
  }

  .also {
    margin: 2rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    font-weight: 700;
    font-stretch: 85%;
    text-transform: uppercase;
  }
  .also-label {
    display: block;
    margin-bottom: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.06em;
  }
  .also .text-link {
    text-transform: none;
    font-family: var(--font-sans);
    font-size: 1rem;
  }

  @media (max-width: 760px) {
    .act {
      grid-template-columns: 1fr;
    }
  }
</style>
