---
import { team } from "../../data/marketing";
import Button from "../marketing/ui/Button.astro";
import Section from "../marketing/ui/Section.astro";

// A slightly different tilt for each badge, so they look pinned on by hand.
const tilts = [-3, 2, -1.5, 3, -2, 1.5, -2.5, 2.5, -1, 1];
---

<Section id="community" tone="blue" labelledby="community-title">
  <div class="container layout">
    <div class="intro" data-reveal>
      <p class="liner">Liner notes</p>
      <h2 id="community-title">Built in the open.</h2>
      <p>
        Music Assistant runs on a device in your home. It’s free and open
        source: anyone can read the code, suggest changes or help improve it. A
        community project of the Open Home Foundation.
      </p>
      <div class="actions">
        <Button
          href="https://github.com/music-assistant"
          trailingIcon="arrow-up-right"
          external
        >
          View on GitHub
        </Button>
        <Button href="/help/" variant="outline">
          Help or donate
        </Button>
      </div>
    </div>

    <div class="band">
      <h3>Brought to you by</h3>
      <ul>
        {team.map((person, index) => (
          <li style={`--tilt: ${tilts[index % tilts.length]}deg`}>
            <a
              href={`https://github.com/${person.github}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              <img
                src={`/assets/team/${person.image}.png`}
                alt=""
                width="200"
                height="200"
                loading="lazy"
                decoding="async"
              />
              <span>{person.name}</span>
              <span class="sr-only"> on GitHub</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Section>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: center;
    gap: clamp(2.5rem, 6vw, 5rem);
  }
  .intro p:not(.liner) {
    font-size: 1.125rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }
  .band h3 {
    margin-bottom: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  ul {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.5rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Pin badges, like the ones on a band's merch table. */
  a {
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    color: var(--ink);
    text-decoration: none;
  }
  img {
    width: 100%;
    max-width: 6.5rem;
    aspect-ratio: 1;
    border: 4px solid var(--ink);
    border-radius: 50%;
    object-fit: cover;
    background: var(--paper);
    box-shadow:
      inset 0 0 0 2px rgba(255, 255, 255, 0.4),
      0 8px 14px -8px rgba(23, 21, 15, 0.7);
    transform: rotate(var(--tilt));
    transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  a:hover img,
  a:focus-visible img {
    transform: rotate(calc(var(--tilt) * -3)) scale(1.08);
  }
  span:not(.sr-only) {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
  }
  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    ul {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
