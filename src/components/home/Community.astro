---
import { team } from "../../data/marketing";
import Button from "../marketing/ui/Button.astro";
---

<section
  id="community"
  class="section community"
  aria-labelledby="community-title"
>
  <div class="container">
    <div class="panel" data-reveal>
      <div class="intro">
        <h2 id="community-title">Built in the open.</h2>
        <p>
          Music Assistant runs on a device in your home. It’s free and open
          source: anyone can read the code, suggest changes or help improve it.
          A community project of the Open Home Foundation.
        </p>
        <div class="actions">
          <Button
            href="https://github.com/music-assistant"
            variant="filled"
            trailingIcon="arrow-up-right"
            external
          >
            View on GitHub
          </Button>
          <Button href="/help/" variant="outline">
            Help or donate
          </Button>
        </div>
      </div>

      <div class="team">
        <h3>Brought to you by</h3>
        <!-- Shown like the artist row in the app: round portraits, names below. -->
        <ul>
          {team.map((person) => (
            <li>
              <a
                href={`https://github.com/${person.github}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                <img
                  src={`/assets/team/${person.image}.png`}
                  alt=""
                  width="200"
                  height="200"
                  loading="lazy"
                  decoding="async"
                />
                <span>{person.name}</span>
                <span class="sr-only"> on GitHub</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .panel {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 5vw, 4rem);
    padding: clamp(1.5rem, 5vw, 3.5rem);
    border: 1px solid var(--border);
    border-radius: 1.75rem;
    background: var(--card);
  }
  .intro p {
    color: var(--muted-foreground);
    font-size: 1.0625rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .team h3 {
    margin-bottom: 1.25rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0;
  }
  ul {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.5rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a {
    display: grid;
    justify-items: center;
    gap: 0.625rem;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
  }
  img {
    width: 100%;
    max-width: 6rem;
    aspect-ratio: 1;
    border-radius: 50%;
    object-fit: cover;
    background: var(--tile);
    box-shadow: 0 0 0 0 var(--primary);
    transition:
      box-shadow 0.2s,
      transform 0.2s;
  }
  a:hover img {
    box-shadow: 0 0 0 3px var(--primary);
    transform: scale(1.03);
  }
  a:hover span {
    color: var(--primary-strong);
  }
  @media (max-width: 900px) {
    .panel {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    ul {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
