---
import { musicSources, speakers } from "../../data/marketing";
import BrandTile from "../marketing/ui/BrandTile.astro";
import Icon from "../marketing/ui/Icon.astro";
import SectionHeading from "../marketing/ui/SectionHeading.astro";
import Logo from "../marketing/ui/Logo.astro";
import Section from "../marketing/ui/Section.astro";
---

<Section id="how-it-works" tone="paper" labelledby="how-title">
  <div class="container">
    <SectionHeading
      id="how-title"
      label="Track 01 · How it works"
      title="One system between your music and your speakers."
      lead="Keep your library and playlists independent of any one music service. Mix speaker brands, switch services and change your setup without starting over."
    />

    <ol class="flow">
      <li class="panel" data-reveal>
        <p class="step">A · Your music</p>
        <p>
          Streaming services, local files, radio, podcasts and audiobooks, in
          one place.
        </p>
        <ul class="brands" aria-label="Some of the supported music sources">
          {musicSources.map((brand) => (
            <BrandTile brand={brand} />
          ))}
        </ul>
        <a class="text-link" href="/music-providers/">
          All music sources <Icon name="arrow-right" size={16} />
        </a>
      </li>

      <li class="panel core tone-ink" data-reveal style="--reveal-delay: 100ms">
        <p class="step">B · The mix</p>
        <div class="core-logo">
          <Logo />
        </div>
        <p>
          Runs on a device in your home. Browse your music, build a queue and
          control every speaker from one app.
        </p>
      </li>

      <li class="panel" data-reveal style="--reveal-delay: 200ms">
        <p class="step">C · Your speakers</p>
        <p>
          Speakers from different brands and ecosystems, in one room or in sync
          throughout your home.
        </p>
        <ul class="brands" aria-label="Some of the supported speakers">
          {speakers.map((brand) => (
            <BrandTile brand={brand} />
          ))}
        </ul>
        <a class="text-link" href="/player-support/">
          All players <Icon name="arrow-right" size={16} />
        </a>
      </li>
    </ol>
  </div>
</Section>

<style>
  .flow {
    display: grid;
    grid-template-columns: 1fr minmax(0, 0.85fr) 1fr;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .panel {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .panel p {
    color: var(--muted);
  }
  .step {
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--line);
    color: var(--fg) !important;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
  }
  .brands {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0.5rem;
    margin: 0.5rem 0 1.5rem;
    padding: 0;
    list-style: none;
  }
  .panel .text-link {
    margin-top: auto;
  }

  .core {
    justify-content: center;
    text-align: center;
    background: var(--ink);
  }
  .core .step {
    position: absolute;
    top: 1.5rem;
    left: 1.5rem;
    right: 1.5rem;
    text-align: left;
  }
  .core-logo {
    height: clamp(1.75rem, 3vw, 2.5rem);
    margin: 4rem auto 1.25rem;
    color: var(--paper);
  }

  /* Arrows between the panels, pointing the way the music goes. */
  .panel:not(:last-child)::after {
    content: "→";
    position: absolute;
    z-index: 1;
    top: 50%;
    right: -1.375rem;
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    color: var(--ink);
    background: var(--butter);
    font-weight: 700;
    line-height: 1;
    transform: translateY(-50%);
  }

  @media (max-width: 1000px) {
    .flow {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
    .panel:not(:last-child)::after {
      content: "↓";
      top: auto;
      right: auto;
      bottom: -1.375rem;
      left: 50%;
      transform: translateX(-50%);
    }
    .core {
      padding-block: 1.5rem 2rem;
    }
  }
  @media (max-width: 1000px) and (min-width: 560px) {
    .brands {
      grid-template-columns: repeat(8, 1fr);
    }
  }
</style>
