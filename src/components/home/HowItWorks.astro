---
import { musicSources, speakers } from "../../data/marketing";
import BrandTile from "../marketing/ui/BrandTile.astro";
import Icon from "../marketing/ui/Icon.astro";
import SectionHeading from "../marketing/ui/SectionHeading.astro";
---

<section id="how-it-works" class="section how" aria-labelledby="how-title">
  <div class="container">
    <SectionHeading
      id="how-title"
      title="One system between your music and your speakers."
      lead="Keep your library and playlists independent of any one music service. Mix speaker brands, switch services and change your setup without starting over."
    />

    <div class="flow">
      <article class="panel" data-reveal>
        <div class="panel-head">
          <span class="step">1</span>
          <h3>Your music</h3>
        </div>
        <p>
          Streaming services, local files, radio, podcasts and audiobooks, in
          one place.
        </p>
        <ul class="brands" aria-label="Some of the supported music sources">
          {musicSources.map((brand) => (
            <BrandTile brand={brand} />
          ))}
        </ul>
        <a class="text-link" href="/music-providers/">
          All music sources <Icon name="arrow-right" size={16} />
        </a>
      </article>

      <div class="link" aria-hidden="true">
        <span></span>
      </div>

      <article class="panel core" data-reveal style="--reveal-delay: 100ms">
        <img
          class="mark"
          src="/favicon.svg"
          alt=""
          width="150"
          height="150"
          loading="lazy"
        />
        <h3>Music Assistant</h3>
        <p>
          Runs on a device in your home. Browse your music, build a queue and
          control every speaker from one app.
        </p>
        <ul class="chips" aria-label="What Music Assistant manages">
          <li>
            <Icon name="library" size={16} />
            Library
          </li>
          <li>
            <Icon name="list-music" size={16} />
            Queue
          </li>
          <li>
            <Icon name="speaker" size={16} />
            Players
          </li>
        </ul>
      </article>

      <div class="link" aria-hidden="true">
        <span></span>
      </div>

      <article class="panel" data-reveal style="--reveal-delay: 200ms">
        <div class="panel-head">
          <span class="step">2</span>
          <h3>Your speakers</h3>
        </div>
        <p>
          Speakers from different brands and ecosystems, in one room or in sync
          throughout your home.
        </p>
        <ul class="brands" aria-label="Some of the supported speakers">
          {speakers.map((brand) => (
            <BrandTile brand={brand} />
          ))}
        </ul>
        <a class="text-link" href="/player-support/">
          All players <Icon name="arrow-right" size={16} />
        </a>
      </article>
    </div>
  </div>
</section>

<style>
  .flow {
    display: grid;
    grid-template-columns: 1fr 3rem minmax(0, 0.8fr) 3rem 1fr;
    align-items: stretch;
  }
  .panel {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: 1.25rem;
    background: var(--card);
    box-shadow: var(--shadow-sm);
  }
  .panel p {
    color: var(--muted-foreground);
  }
  .panel-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }
  .panel-head h3 {
    margin: 0;
  }
  .step {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--primary-soft);
    color: var(--primary-strong);
    font-size: 0.8125rem;
    font-weight: 700;
  }
  .brands {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0.5rem;
    margin: 0.5rem 0 1.5rem;
    padding: 0;
    list-style: none;
  }
  .panel .text-link {
    margin-top: auto;
  }

  .core {
    align-items: center;
    justify-content: center;
    text-align: center;
    border-color: color-mix(in srgb, var(--primary) 45%, var(--border));
    background:
      radial-gradient(
        120% 80% at 50% 0%,
        color-mix(in srgb, var(--primary) 16%, transparent),
        transparent 70%
      ),
      var(--card);
  }
  .mark {
    width: 4rem;
    margin-bottom: 1.25rem;
    filter: drop-shadow(
      0 8px 20px color-mix(in srgb, var(--primary) 40%, transparent)
    );
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .chips li {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
  }
  .chips :global(.icon) {
    color: var(--primary);
  }

  /* Signal travelling from the music, through Music Assistant, to speakers. */
  .link {
    position: relative;
    display: grid;
    align-items: center;
  }
  .link span {
    height: 2px;
    background: linear-gradient(
      90deg,
      var(--border) 0 50%,
      var(--primary) 50% 100%
    );
    background-size: 200% 100%;
    animation: signal 2.4s linear infinite;
  }
  @keyframes signal {
    from {
      background-position: 100% 0;
    }
    to {
      background-position: -100% 0;
    }
  }

  @media (max-width: 1000px) {
    .flow {
      grid-template-columns: 1fr;
    }
    .link {
      justify-items: center;
      height: 2rem;
    }
    .link span {
      width: 2px;
      height: 100%;
      background: linear-gradient(
        180deg,
        var(--border) 0 50%,
        var(--primary) 50% 100%
      );
      background-size: 100% 200%;
      animation-name: signal-down;
    }
    @keyframes signal-down {
      from {
        background-position: 0 100%;
      }
      to {
        background-position: 0 -100%;
      }
    }
    .core {
      padding-block: 2rem;
    }
  }
  @media (max-width: 1000px) and (min-width: 560px) {
    .brands {
      grid-template-columns: repeat(8, 1fr);
    }
  }
</style>
