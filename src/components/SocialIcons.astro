---
// Adds a Documentation menu to the header, then renders Starlight's own social
// icons unchanged. The menu only appears on the landing page: every other page
// has the sidebar, which already lists these sections.
import Default from '@astrojs/starlight/components/SocialIcons.astro';

const sections = [
  { label: 'Install Music Assistant', href: '/installation/' },
  { label: 'Home Assistant Integration', href: '/integration/' },
  { label: 'Music Sources', href: '/music-providers/' },
  { label: 'Player Providers', href: '/player-support/' },
  { label: 'Using Music Assistant', href: '/usage/' },
  { label: 'Plugins', href: '/plugins/' },
  { label: 'Troubleshooting', href: '/faq/troubleshooting/' },
];
---

<details class="docs-menu">
  <summary>Documentation</summary>
  <ul>
    {sections.map(({ label, href }) => (
      <li><a href={href}>{label}</a></li>
    ))}
  </ul>
</details>

<Default />

<script>
  // <details> has no built-in dismissal, so close the menu on an outside
  // click or Escape. Choosing an entry navigates away, which closes it anyway.
  const close = () =>
    document
      .querySelectorAll<HTMLDetailsElement>('details.docs-menu[open]')
      .forEach((menu) => (menu.open = false));

  document.addEventListener('click', (event) => {
    const menu = document.querySelector('details.docs-menu[open]');
    if (menu && !menu.contains(event.target as Node)) close();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') close();
  });
</script>
