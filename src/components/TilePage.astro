---
import { existsSync } from "node:fs";
import { pathToFileURL } from "node:url";
import { getCollection } from "astro:content";
import type { TileCategory, TilePage } from "../data/tile-page";

interface Props {
  page: TilePage;
}

const { page } = Astro.props;

// ---------------------------------------------------------------------------
// Guard rails for the page's data file.
//
// Everything below runs while the site is being built. A mistake in the data
// file stops the build with an explicit message rather than shipping a broken
// link or a missing image.
// ---------------------------------------------------------------------------

const KNOWN_UNLISTED = new Set(page.knownUnlisted);

const docs = await getCollection("docs");
const knownSlugs = new Set(docs.map((entry) => entry.id));
// Anchored to the project root rather than to this file. Astro 6 builds the
// component into dist/.prerender/, so a path relative to import.meta.url looks
// for the icons somewhere they have never been and reports every one missing.
const publicDir = new URL("public/", pathToFileURL(`${process.cwd()}/`));

const allCategories: TileCategory[] = page.groups.flatMap((g) => g.categories);
const knownCategoryIds = new Set(allCategories.map((c) => c.id));

const problems: string[] = [];
const seenSlugs = new Set<string>();
const seenNames = new Set<string>();

for (const category of allCategories) {
  if (!existsSync(new URL(`.${category.icon}`, publicDir))) {
    problems.push(
      `the category "${category.id}" has the icon "${category.icon}", but ` +
        `that file does not exist. Expected a file at public${category.icon}. ` +
        `Category icons are normally named after the category itself, so ` +
        `"${category.id}" wants an icon named after it.`,
    );
  }
}

for (const source of page.items) {
  const where = `the entry named "${source.name}"`;

  // Name and slug together, rather than either alone. Several tiles lead to one
  // page, since the players page names its tiles after makes: Denon and Marantz
  // both open HEOS. And one name can appear more than once, since the three
  // catch-alls are all called "Other". Repeating both is a copy-paste.
  const identity = `${source.name}\u0000${source.slug}`;
  if (seenNames.has(identity)) {
    problems.push(
      `${where} appears twice with the same name and the same slug, so it ` +
        `would be listed twice. Delete whichever of the two is the duplicate.`,
    );
  }
  seenNames.add(identity);
  seenSlugs.add(source.slug);

  if (!knownSlugs.has(source.slug)) {
    problems.push(
      `${where} has the slug "${source.slug}", but there is no documentation ` +
        `page with that name. Expected a file at src/content/docs/${source.slug}.md — ` +
        `check the spelling, and remember the slug includes the folder, for ` +
        `example "music-providers/spotify".`,
    );
  }

  if (!source.icon.startsWith("/assets/")) {
    problems.push(
      `${where} has the icon "${source.icon}". Icon paths must start with ` +
        `"/assets/", for example "/assets/icons/spotify-icon.svg".`,
    );
  } else if (!existsSync(new URL(`.${source.icon}`, publicDir))) {
    problems.push(
      `${where} has the icon "${source.icon}", but that file does not exist. ` +
        `Expected a file at public${source.icon} — file names are case ` +
        `sensitive, and note that some icons end in .png and others in .svg.`,
    );
  }

  if (source.via?.icon && !existsSync(new URL(`.${source.via.icon}`, publicDir))) {
    problems.push(
      `${where} has the "powered by" icon "${source.via.icon}", but that file ` +
        `does not exist. Expected a file at public${source.via.icon}.`,
    );
  }

  if (source.categories.length === 0) {
    problems.push(
      `${where} has an empty "categories" list, so it would not appear ` +
        `anywhere on the page. Give it at least one category.`,
    );
  }

  for (const id of source.categories) {
    if (!knownCategoryIds.has(id)) {
      problems.push(
        `${where} uses the category "${id}", which is not one of the ` +
          `categories defined at the top of ${page.dataFile}. ` +
          `The valid categories are: ` +
          `${[...knownCategoryIds].join(", ")}.`,
      );
    }
  }
}

const sourcesFor = (id: string) =>
  page.items.filter((source) => source.categories.includes(id));

for (const id of knownCategoryIds) {
  if (sourcesFor(id).length === 0) {
    problems.push(
      `The category "${id}" is defined but no music source uses it, so it ` +
        `would appear on the page as an empty heading. Either tag a source ` +
        `with it or remove the category.`,
    );
  }
}

// A new provider page must be added here too, otherwise it would quietly
// never appear on the page. Adding a source is the moment to categorise it.
for (const entry of docs) {
  const slug = entry.id;
  if (!slug.startsWith(page.pathPrefix)) continue;
  if (KNOWN_UNLISTED.has(slug) || seenSlugs.has(slug)) continue;
  problems.push(
    `"${slug}" has a documentation page but no entry in this file, so it ` +
      `would never appear on the page. Add it to ${page.dataFile}, keeping the ` +
      `list alphabetical:\n\n` +
      `       {\n` +
      `         name: "${entry.data.title}",\n` +
      `         slug: "${slug}",\n` +
      `         icon: "/assets/icons/CHANGE-ME.svg",\n` +
      `         categories: ["CHANGE-ME"],\n` +
      `       },\n\n` +
      `     Use the same icon as the top of that page, and pick ` +
      `categories from: ${[...knownCategoryIds].join(", ")}. If the source ` +
      `genuinely belongs in none of them, add its slug to the knownUnlisted ` +
      `list at the bottom of ${page.dataFile} instead.`,
  );
}

if (problems.length > 0) {
  throw new Error(
    `\n\n${page.dataFile} has ${problems.length} problem${problems.length === 1 ? "" : "s"}:\n\n` +
      problems.map((problem, i) => `  ${i + 1}. ${problem}`).join("\n\n") +
      `\n\nFix the file and build again.\n`,
  );
}
---

<div class="tiles not-content">
  {
    page.groups.map((group) => (
      <nav class="tiles__nav" aria-labelledby={`${page.idPrefix}-nav-${group.id}`}>
        <h2 class="tiles__title" id={`${page.idPrefix}-nav-${group.id}`}>
          {group.title}
        </h2>
        <p class="tiles__blurb">{group.intro}</p>
        <ul
          class:list={[
            "tiles__grid",
            "tiles__grid--wide",
            group.columns && "tiles__grid--fixed",
          ]}
          style={group.columns ? `--tiles-cols: ${group.columns}` : undefined}
        >
          {group.categories.map((category) => (
            <li>
              <a class="tiles__tile" href={`#${page.idPrefix}-${category.id}`}>
                <span
                  class:list={[
                    "tiles__logo",
                    group.id === page.flagGroupId && "tiles__logo--flag",
                  ]}
                >
                  <img
                    src={category.icon}
                    alt=""
                    aria-hidden="true"
                    decoding="async"
                  />
                </span>
                <span class="tiles__name">{category.title}</span>
                <span class="tiles__count">
                  {sourcesFor(category.id).length}{" "}
                  {sourcesFor(category.id).length === 1
                    ? page.itemNoun
                    : `${page.itemNoun}s`}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ))
  }

  {
    allCategories.map((category) => (
      <section
        class="tiles__section"
        aria-labelledby={`${page.idPrefix}-${category.id}`}
      >
        <h2 class="tiles__title" id={`${page.idPrefix}-${category.id}`} tabindex="-1">
          {category.title}
        </h2>
        <p class="tiles__blurb">{category.blurb}</p>
        <ul class="tiles__grid" data-pagefind-ignore>
          {sourcesFor(category.id).map((source) => (
            <li>
              <a class="tiles__tile" href={`/${source.slug}/`}>
                <span
                  class="tiles__logo"
                  style={
                    source.iconHeight
                      ? `--tiles-logo-max: ${source.iconHeight}`
                      : undefined
                  }
                >
                  <img
                    src={source.icon}
                    alt={source.iconAlt ?? ""}
                    aria-hidden={source.iconAlt ? undefined : "true"}
                    loading="lazy"
                    decoding="async"
                  />
                </span>
                <span
                  class:list={[
                    "tiles__name",
                    source.nameHidden && "tiles__sronly",
                  ]}
                >
                  {source.name}
                </span>
                {source.via && (
                  <span class="tiles__via">
                    <span class="tiles__via-label">Powered by</span>
                    {source.via.icon ? (
                      <img
                        class="tiles__via-mark"
                        src={source.via.icon}
                        alt={source.via.label}
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      source.via.label
                    )}
                  </span>
                )}
              </a>
            </li>
          ))}
        </ul>
        <a class="tiles__top" href="#_top">Back to the top</a>
      </section>
    ))
  }
</div>

<style>
  .tiles {
    margin-block: 2rem;
  }

  .tiles__nav + .tiles__nav {
    margin-top: 2rem;
  }

  .tiles__title {
    margin: 0;
    font-size: var(--sl-text-h3);
    font-weight: 600;
    line-height: var(--sl-line-height-headings);
    color: var(--sl-color-white);
  }

  .tiles__title:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 4px;
    border-radius: 0.25rem;
  }

  .tiles__blurb {
    margin: 0.35rem 0 0;
    font-size: var(--sl-text-sm);
    line-height: 1.5;
    color: var(--sl-color-gray-3);
  }

  .tiles__tile:focus-visible,
  .tiles__top:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  .tiles__count {
    margin-top: -0.25rem;
    font-size: var(--sl-text-xs);
    font-weight: 400;
    color: var(--sl-color-gray-3);
  }

  .tiles__section {
    margin-top: 2.75rem;
  }

  /* auto-fill rather than auto-fit: several categories hold a single source,
     and auto-fit would stretch that one tile across the whole page. */
  .tiles__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr));
    grid-auto-rows: 1fr;
    gap: 0.75rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  /* Category names run longer than source names, so they get wider tiles.
     9.5rem is the widest that still gives two columns on a 375px phone. */
  .tiles__grid--wide {
    grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
  }

  /* Only once the content column is wide enough to divide. Below this the
     sidebar has gone and the page is under 500px, where five columns would be
     85px each, so fitting is left to do its job. */
  @media (min-width: 50rem) {
    .tiles__grid--fixed {
      grid-template-columns: repeat(var(--tiles-cols), 1fr);
    }
  }

  .tiles__tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    height: 100%;
    padding: 0.9rem 0.6rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.6rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-white);
    text-align: center;
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease,
      transform 0.15s ease;
  }

  .tiles__tile:hover {
    border-color: var(--sl-color-accent);
    box-shadow: var(--sl-shadow-sm);
    transform: translateY(-2px);
  }

  /* Fixed box so square icons and wide wordmarks both sit correctly. */
  .tiles__logo {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 3rem;
  }

  .tiles__logo img {
    max-width: 100%;
    max-height: var(--tiles-logo-max, 100%);
    width: auto;
    height: auto;
    margin: 0;
    object-fit: contain;
  }

  /* Flags carry white in them, so they need an edge against the white tile. */
  .tiles__logo--flag img {
    max-height: 2.1rem;
    border-radius: 2px;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.15);
  }

  /* Says which page the tile opens, for the makes whose provider goes by
     another name. Sized like the category count so the two read as one idea. */
  .tiles__via {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.15rem 0.3rem;
    margin-top: -0.35rem;
    font-size: var(--sl-text-xs);
    font-weight: 400;
    line-height: 1.2;
    color: var(--sl-color-gray-3);
  }

  /* Read out but never shown, for a tile whose logo says the name already. */
  .tiles__sronly {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .tiles__via-label {
    white-space: nowrap;
  }

  /* Two classes deep for the same reason .tiles__logo img is: the tiles are
     list items, and Starlight's ".sl-markdown-content li img" sets height to
     auto, which outweighs a single class and lets the mark render full size. */
  .tiles__via .tiles__via-mark {
    height: 1rem;
    width: auto;
    max-width: 4.5rem;
    margin: 0;
    object-fit: contain;
  }

  .tiles__name {
    font-size: var(--sl-text-sm);
    font-weight: 600;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .tiles__top {
    display: inline-block;
    margin-top: 0.9rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
    text-decoration: none;
  }

  .tiles__top:hover {
    color: var(--sl-color-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .tiles__chip,
    .tiles__tile {
      transition: none;
    }

    .tiles__tile:hover {
      transform: none;
    }
  }
</style>
