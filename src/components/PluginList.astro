---
import { getCollection } from "astro:content";
import { PLUGIN_GROUPS } from "../content.config";

// ---------------------------------------------------------------------------
// The list of every plugin, for the bottom of the Plugins overview.
//
// Each plugin page carries its own summary and group in its frontmatter, so
// the list is the pages rather than a copy of them, and a renamed or reworded
// plugin follows on its own. The group and the summary are checked as the page
// loads, by the schema in src/content.config.ts.
//
// What the schema cannot see is a plugin page that names no group at all, so
// that is checked here: it stops the build with a block to paste. Without it
// the list would be a fourth place to remember when a plugin is added, after
// the page, the sidebar and the release notes.
//
// Only the plugins folder is checked that way, since only it is guaranteed to
// hold plugins and nothing else. A plugin page outside it, as the Home
// Assistant one is, joins the list by carrying the frontmatter.
// ---------------------------------------------------------------------------

const docs = await getCollection("docs");

const missing = docs.filter(
  (entry) =>
    entry.id.startsWith("plugins/") &&
    entry.id !== "plugins/index" &&
    !entry.data.plugin,
);

if (missing.length > 0) {
  throw new Error(
    `\n\n${missing.length} plugin page${missing.length === 1 ? " has" : "s have"} no "plugin" ` +
      `block in ${missing.length === 1 ? "its" : "their"} frontmatter, so ` +
      `${missing.length === 1 ? "it" : "they"} would never appear in the list of plugins on ` +
      `the overview page:\n\n` +
      missing
        .map(
          (entry, i) =>
            `  ${i + 1}. src/content/docs/${entry.id}.md — add this under its ` +
            `description:\n\n` +
            `       plugin:\n` +
            `         group: CHANGE-ME\n` +
            `         summary: "CHANGE ME. One sentence on what it does."\n`,
        )
        .join("\n") +
      `\n     Pick a group from: ${PLUGIN_GROUPS.map((group) => group.id).join(", ")}. ` +
      `They are defined in src/content.config.ts.\n\n` +
      `Fix the pages and build again.\n`,
  );
}

/**
 * Page titles carry a "Plugin" suffix where the plugin's name alone would read
 * as something else, as the Profiler and the Party pages do. In a list of
 * nothing but plugins that suffix is on every second line and says nothing.
 */
const nameFor = (title: string) => title.replace(/ Plugin( Provider)?$/, "");

const plugins = docs
  .filter((entry) => entry.data.plugin)
  .map((entry) => ({
    slug: entry.id,
    name: nameFor(entry.data.title),
    summary: entry.data.plugin!.summary,
    group: entry.data.plugin!.group,
  }))
  .sort((a, b) => a.name.localeCompare(b.name));

const groups = PLUGIN_GROUPS.map((group) => ({
  ...group,
  plugins: plugins.filter((plugin) => plugin.group === group.id),
})).filter((group) => group.plugins.length > 0);
---

<div class="plugin-list">
  {
    groups.map((group) => (
      <section aria-labelledby={`plugin-group-${group.id}`}>
        <h3 class="plugin-list__title" id={`plugin-group-${group.id}`}>
          {group.title}
        </h3>
        <ul class="plugin-list__items">
          {group.plugins.map((plugin) => (
            <li>
              <a href={`/${plugin.slug}/`}>{plugin.name}</a>
              <span class="plugin-list__summary">{plugin.summary}</span>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .plugin-list__title {
    font-size: var(--sl-text-h4);
  }

  .plugin-list__items {
    padding-left: 0;
    list-style: none;
  }

  .plugin-list__items li + li {
    margin-top: 0.5rem;
  }

  .plugin-list__items a {
    font-weight: 600;
  }

  /* The summary reads as a continuation of the name, so it stays on the same
     line where there is room and wraps under it where there is not. */
  .plugin-list__summary::before {
    content: " — ";
    color: var(--sl-color-gray-3);
  }

  .plugin-list__summary {
    color: var(--sl-color-gray-2);
  }
</style>
