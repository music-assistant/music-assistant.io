---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<li class="step">
  <div class="marker" aria-hidden="true"></div>
  <div class="content">
    <h3>{title}</h3>
    <slot />
  </div>
</li>

<style>
  .step {
    position: relative;
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: 1.25rem;
    padding-bottom: 2rem;
    counter-increment: step;
  }
  .step:last-child {
    padding-bottom: 0;
  }
  .step:not(:last-child)::before {
    content: "";
    position: absolute;
    top: 2.75rem;
    bottom: 0.5rem;
    left: calc(1.125rem - 1px);
    width: 2px;
    border-radius: 1px;
    background: var(--border);
  }
  .marker {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--primary);
    color: var(--primary-foreground);
    font-weight: 700;
  }
  .marker::before {
    content: counter(step);
  }
  h3 {
    margin: 0.375rem 0 0.5rem;
    font-size: 1.125rem;
  }
  .content :global(p) {
    margin-bottom: 0;
    color: var(--muted-foreground);
  }
  .content :global(strong) {
    color: var(--foreground);
    font-weight: 600;
  }
</style>
