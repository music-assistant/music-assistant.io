---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<li class="step">
  <div class="marker" aria-hidden="true"></div>
  <div class="content">
    <h3>{title}</h3>
    <slot />
  </div>
</li>

<style>
  .step {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 1.25rem;
    padding-bottom: 2rem;
    counter-increment: step;
  }
  .step:last-child {
    padding-bottom: 0;
  }
  .step:not(:last-child)::before {
    content: "";
    position: absolute;
    top: 3rem;
    bottom: 0.5rem;
    left: calc(1.25rem - 1px);
    border-left: 2px dashed var(--line);
  }
  .marker {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 1px solid var(--accent);
    color: var(--link);
    font-family: var(--font-mono);
    font-size: 0.9375rem;
  }
  .marker::before {
    content: counter(step);
  }
  h3 {
    margin: 0.375rem 0 0.5rem;
    font-size: 1.625rem;
    text-transform: uppercase;
  }
  .content :global(p) {
    margin-bottom: 0;
    color: var(--muted);
  }
  .content :global(strong) {
    color: var(--fg);
    font-weight: 600;
  }
</style>
